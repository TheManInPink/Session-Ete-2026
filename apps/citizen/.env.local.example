# ── apps/citizen — variables d'environnement ──────────────────────────────────
# Copier ce fichier vers `.env.local` et adapter les valeurs.

# URL de base de l'API NINA-AES (côté serveur RSC — réseau interne K8s en prod)
API_BASE_URL=http://localhost:3000

# Issuer Keycloak (utilisé pour OIDC PKCE — doc 08)
KEYCLOAK_ISSUER=http://localhost:8080/realms/nina-aes
KEYCLOAK_CLIENT_ID=nina-citizen

# URL publique de l'app (utilisée pour redirect_uri OIDC)
APP_PUBLIC_URL=http://localhost:4001

# Drapeau : si vrai, les pages affichent des bannières "mode démo" tant que
# le backend n'est pas connecté. À false en production.
NEXT_PUBLIC_DEMO_MODE=true

# ── Couche données (api-client) ───────────────────────────────────────────────
# Mode d'alimentation : 'mock' (fixtures déterministes, zéro réseau) | 'live'
# (backend réel via le gateway). Si absent, dérivé de NEXT_PUBLIC_DEMO_MODE.
# ⚠️ Sécurité : 'mock' est INTERDIT en production (échec au boot via
#    instrumentation.ts — fail-closed contre la fuite de fausses identités).
NEXT_PUBLIC_NINA_API_MODE=mock

# URL publique de l'app — base same-origin des appels authentifiés passant par
# le BFF (app/api/v1/[...path]). Utilisée uniquement en mode 'live'.
NEXT_PUBLIC_APP_URL=http://localhost:4001

# URL publique du gateway — UNIQUEMENT pour le signalement anonyme SIGAC,
# appelé en direct depuis le navigateur (cookies omis → anonymat). Mode 'live'.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
