@startuml NINA-AES_UseCases
' ════════════════════════════════════════════════════════════════════════════
'  NINA-AES Platform — Diagramme de cas d'utilisation (UC)
'  9 acteurs · 8 packages métier · 26 cas d'utilisation
'  Auteur : Étudiant UQAR · Avril 2026
' ════════════════════════════════════════════════════════════════════════════

title NINA-AES — Cas d'utilisation (Blocs A → F)

skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam roundcorner 6
skinparam usecase {
  BackgroundColor #EAF4FF
  BorderColor #2563EB
  ArrowColor #475569
  FontName Inter
}
skinparam actor {
  BackgroundColor #FEF3C7
  BorderColor #D97706
}
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
  FontStyle bold
}

left to right direction

' ── Acteurs ─────────────────────────────────────────────────────────────────
:Citoyen: as Citizen
:Citoyen Diaspora: as Diaspora
:Personne Vulnérable: as Vulnerable
:Agent CTDEC: as Agent
:Superviseur: as Supervisor
:Administrateur: as Admin
:Auditeur Anti-Corruption: as Auditor
:Système AES (BFA / NER): as AES
:Module IA: as AI

' ── 1. Gestion Identité NINA ────────────────────────────────────────────────
package "1. Gestion Identité NINA" as P1 {
  usecase "UC01 — Rechercher mon NINA" as UC01
  usecase "UC02 — Consulter ma fiche descriptive (FDI)" as UC02
  usecase "UC03 — Demander une correction" as UC03
  usecase "UC04 — Téléverser un justificatif" as UC04
  usecase "UC05 — Recevoir QR code signé (JWT RS256)" as UC05
}

' ── 2. Gestion Rendez-vous ─────────────────────────────────────────────────
package "2. Gestion Rendez-vous" as P2 {
  usecase "UC06 — Prendre rendez-vous CTDEC" as UC06
  usecase "UC07 — Annuler / reprogrammer RDV" as UC07
  usecase "UC08 — Recevoir rappel SMS / USSD" as UC08
}

' ── 3. Administration ───────────────────────────────────────────────────────
package "3. Administration" as P3 {
  usecase "UC09 — Examiner les corrections en attente" as UC09
  usecase "UC10 — Approuver / rejeter une correction" as UC10
  usecase "UC11 — Régénérer la FDI signée" as UC11
  usecase "UC12 — Gérer les comptes agents" as UC12
}

' ── 4. Anti-Corruption (SIGAC) ──────────────────────────────────────────────
package "4. Anti-Corruption (SIGAC)" as P4 {
  usecase "UC13 — Signaler anonymement un fait" as UC13
  usecase "UC14 — Suivre l'instruction (token anonyme)" as UC14
  usecase "UC15 — Investiguer une alerte" as UC15
  usecase "UC16 — Calculer score d'intégrité agent" as UC16
}

' ── 5. Gouvernance Traçable (SGOGT) ────────────────────────────────────────
package "5. Gouvernance Traçable (SGOGT)" as P5 {
  usecase "UC17 — Émettre directive signée Ed25519" as UC17
  usecase "UC18 — Échanger messages institutionnels" as UC18
  usecase "UC19 — Escalader directive non honorée" as UC19
}

' ── 6. Interopérabilité AES ─────────────────────────────────────────────────
package "6. Interopérabilité AES" as P6 {
  usecase "UC20 — Vérifier identité transfrontalière" as UC20
  usecase "UC21 — Répondre vérification (booléen + confiance)" as UC21
}

' ── 7. Intelligence Artificielle ────────────────────────────────────────────
package "7. Intelligence Artificielle" as P7 {
  usecase "UC22 — Détecter anomalies de saisie" as UC22
  usecase "UC23 — Proposer corrections fuzzy" as UC23
  usecase "UC24 — Classifier signalement (NLP)" as UC24
}

' ── 8. Accessibilité ────────────────────────────────────────────────────────
package "8. Accessibilité" as P8 {
  usecase "UC25 — Consulter NINA via USSD (8 langues)" as UC25
  usecase "UC26 — File prioritaire personne vulnérable" as UC26
}

