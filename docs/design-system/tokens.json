  "shadow": {
    "$comment": "6 niveaux d'élévation, ombres légères (saturation 8%) pour rester sobres",
    "xs": { "$value": "0 1px 2px 0 hsl(0 0% 0% / 0.04)", "$type": "shadow" },
    "sm": {
      "$value": "0 1px 3px 0 hsl(0 0% 0% / 0.08), 0 1px 2px -1px hsl(0 0% 0% / 0.06)",
      "$type": "shadow"
    },
    "base": {
      "$value": "0 4px 6px -1px hsl(0 0% 0% / 0.08), 0 2px 4px -2px hsl(0 0% 0% / 0.05)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 10px 15px -3px hsl(0 0% 0% / 0.10), 0 4px 6px -4px hsl(0 0% 0% / 0.06)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 20px 25px -5px hsl(0 0% 0% / 0.10), 0 8px 10px -6px hsl(0 0% 0% / 0.06)",
