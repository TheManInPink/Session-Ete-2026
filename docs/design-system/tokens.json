{
  "$schema": "https://style-dictionary.com/schemas/tokens-v1.json",
  "$description": "Tokens NINA-AES — Style Dictionary 4 format. Source de vérité de toutes les valeurs visuelles. Génère automatiquement Tailwind config + variables CSS HSL + thème dark mode.",
  "color": {
    "primary": {
      "$comment": "Bleu marine institutionnel (charte §1.1). Les 3 navy de la charte → 600/700/800 : #274D73 (primary-light/hover) / #1B3A5C (--primary) / #122841 (primary-dark).",
      "50": { "$value": "{color.primary.hsl.50}", "$type": "color" },
      "100": { "$value": "{color.primary.hsl.100}", "$type": "color" },
      "200": { "$value": "{color.primary.hsl.200}", "$type": "color" },
      "300": { "$value": "{color.primary.hsl.300}", "$type": "color" },
      "400": { "$value": "{color.primary.hsl.400}", "$type": "color" },
      "500": { "$value": "{color.primary.hsl.500}", "$type": "color" },
      "600": { "$value": "{color.primary.hsl.600}", "$type": "color" },
      "700": { "$value": "{color.primary.hsl.700}", "$type": "color" },
      "800": { "$value": "{color.primary.hsl.800}", "$type": "color" },
      "900": { "$value": "{color.primary.hsl.900}", "$type": "color" },
      "950": { "$value": "{color.primary.hsl.950}", "$type": "color" },
      "hsl": {
        "50": { "$value": "hsl(210, 60%, 97%)" },
        "100": { "$value": "hsl(210, 58%, 91%)" },
        "200": { "$value": "hsl(210, 55%, 82%)" },
        "300": { "$value": "hsl(210, 52%, 68%)" },
        "400": { "$value": "hsl(209, 50%, 54%)" },
        "500": { "$value": "hsl(209, 50%, 42%)" },
        "600": { "$value": "hsl(210, 49%, 30%)" },
        "700": { "$value": "hsl(211, 55%, 23%)" },
        "800": { "$value": "hsl(212, 57%, 16%)" },
        "900": { "$value": "hsl(213, 60%, 12%)" },
        "950": { "$value": "hsl(214, 65%, 8%)" }
      }
    },
    "accent": {
      "$comment": "Bleu accent (charte §1.1 : #2E75B6) — liens, icônes actives, badges, focus rings. accent-500 = #2E75B6, accent-400 = #4A91D0 (hover).",
      "50": { "$value": "hsl(207, 72%, 96%)", "$type": "color" },
      "100": { "$value": "hsl(207, 70%, 90%)", "$type": "color" },
      "200": { "$value": "hsl(207, 66%, 80%)", "$type": "color" },
      "300": { "$value": "hsl(207, 60%, 68%)", "$type": "color" },
      "400": { "$value": "hsl(207, 58%, 55%)", "$type": "color" },
      "500": { "$value": "hsl(207, 60%, 45%)", "$type": "color" },
      "600": { "$value": "hsl(208, 63%, 38%)", "$type": "color" },
      "700": { "$value": "hsl(209, 66%, 30%)", "$type": "color" },
      "800": { "$value": "hsl(210, 70%, 23%)", "$type": "color" },
      "900": { "$value": "hsl(211, 74%, 16%)", "$type": "color" },
      "950": { "$value": "hsl(212, 80%, 10%)", "$type": "color" }
    },
    "neutral": {
      "$comment": "Slate froid (charte §1.1 : bg #F8FAFC, muted #64748B, border #E2E8F0). Ramp Tailwind slate.",
