    "warning": {
      "$comment": "Ambre (charte §1.1 : #E6A817, badge bg #FFF8E1).",
      "50": { "$value": "hsl(45, 100%, 94%)", "$type": "color" },
      "500": { "$value": "hsl(43, 82%, 50%)", "$type": "color" },
      "700": { "$value": "hsl(40, 90%, 35%)", "$type": "color" },
      "800": { "$value": "hsl(38, 92%, 28%)", "$type": "color" },
      "900": { "$value": "hsl(36, 95%, 18%)", "$type": "color" }
    },
    "danger": {
      "$comment": "Rouge (charte §1.1 : #CC0000, badge bg #FFEAEA).",
      "50": { "$value": "hsl(0, 100%, 96%)", "$type": "color" },
      "500": { "$value": "hsl(0, 84%, 55%)", "$type": "color" },
      "700": { "$value": "hsl(0, 100%, 40%)", "$type": "color" },
      "900": { "$value": "hsl(0, 100%, 22%)", "$type": "color" }
