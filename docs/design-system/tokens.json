{
  "$schema": "https://style-dictionary.com/schemas/tokens-v1.json",
  "$description": "Tokens NINA-AES — Style Dictionary 4 format. Source de vérité de toutes les valeurs visuelles. Génère automatiquement Tailwind config + variables CSS HSL + thème dark mode.",
  "color": {
    "primary": {
      "50":  { "$value": "{color.primary.hsl.50}",  "$type": "color" },
      "100": { "$value": "{color.primary.hsl.100}", "$type": "color" },
      "200": { "$value": "{color.primary.hsl.200}", "$type": "color" },
      "300": { "$value": "{color.primary.hsl.300}", "$type": "color" },
      "400": { "$value": "{color.primary.hsl.400}", "$type": "color" },
      "500": { "$value": "{color.primary.hsl.500}", "$type": "color" },
      "600": { "$value": "{color.primary.hsl.600}", "$type": "color" },
      "700": { "$value": "{color.primary.hsl.700}", "$type": "color" },
      "800": { "$value": "{color.primary.hsl.800}", "$type": "color" },
      "900": { "$value": "{color.primary.hsl.900}", "$type": "color" },
      "950": { "$value": "{color.primary.hsl.950}", "$type": "color" },
      "hsl": {
        "50":  { "$value": "hsl(213, 80%, 96%)" },
        "100": { "$value": "hsl(213, 75%, 90%)" },
        "200": { "$value": "hsl(213, 70%, 80%)" },
        "300": { "$value": "hsl(213, 65%, 68%)" },
        "400": { "$value": "hsl(213, 60%, 54%)" },
        "500": { "$value": "hsl(213, 60%, 42%)" },
        "600": { "$value": "hsl(213, 65%, 32%)" },
        "700": { "$value": "hsl(213, 70%, 25%)" },
        "800": { "$value": "hsl(213, 72%, 20%)" },
        "900": { "$value": "hsl(213, 74%, 16%)" },
        "950": { "$value": "hsl(213, 78%, 10%)" }
      }
    },
    "accent": {
      "$comment": "Turquoise lumineux pour CTAs — choisi pour AAA contrast sur fond primary-700",
      "50":  { "$value": "hsl(180, 80%, 96%)", "$type": "color" },
      "100": { "$value": "hsl(180, 75%, 90%)", "$type": "color" },
      "200": { "$value": "hsl(180, 70%, 80%)", "$type": "color" },
      "300": { "$value": "hsl(180, 70%, 65%)", "$type": "color" },
      "400": { "$value": "hsl(180, 70%, 50%)", "$type": "color" },
      "500": { "$value": "hsl(180, 75%, 42%)", "$type": "color" },
      "600": { "$value": "hsl(180, 80%, 32%)", "$type": "color" },
      "700": { "$value": "hsl(180, 82%, 25%)", "$type": "color" },
      "800": { "$value": "hsl(180, 84%, 20%)", "$type": "color" },
      "900": { "$value": "hsl(180, 86%, 14%)", "$type": "color" },
      "950": { "$value": "hsl(180, 88%, 9%)",  "$type": "color" }
    },
    "neutral": {
      "$comment": "Grays légèrement chauds (saturation 8% sur OKLCH-equivalent) pour éviter le rendu froid",
      "50":  { "$value": "hsl(30, 8%, 98%)",  "$type": "color" },
      "100": { "$value": "hsl(30, 8%, 95%)",  "$type": "color" },
      "200": { "$value": "hsl(30, 6%, 89%)",  "$type": "color" },
      "300": { "$value": "hsl(30, 5%, 78%)",  "$type": "color" },
      "400": { "$value": "hsl(30, 4%, 60%)",  "$type": "color" },
      "500": { "$value": "hsl(30, 4%, 46%)",  "$type": "color" },
      "600": { "$value": "hsl(30, 5%, 36%)",  "$type": "color" },
      "700": { "$value": "hsl(30, 6%, 28%)",  "$type": "color" },
      "800": { "$value": "hsl(30, 7%, 18%)",  "$type": "color" },
      "900": { "$value": "hsl(30, 8%, 12%)",  "$type": "color" },
      "950": { "$value": "hsl(30, 10%, 6%)",  "$type": "color" }
    },
    "success": {
      "50":  { "$value": "hsl(142, 76%, 96%)", "$type": "color" },
      "500": { "$value": "hsl(142, 71%, 45%)", "$type": "color" },
      "700": { "$value": "hsl(142, 75%, 28%)", "$type": "color" },
      "900": { "$value": "hsl(142, 80%, 16%)", "$type": "color" }
    },
    "warning": {
      "50":  { "$value": "hsl(38, 92%, 96%)", "$type": "color" },
      "500": { "$value": "hsl(38, 92%, 50%)", "$type": "color" },
      "700": { "$value": "hsl(38, 95%, 35%)", "$type": "color" },
      "900": { "$value": "hsl(38, 98%, 18%)", "$type": "color" }
    },
    "danger": {
      "50":  { "$value": "hsl(0, 86%, 97%)", "$type": "color" },
      "500": { "$value": "hsl(0, 84%, 60%)", "$type": "color" },
      "700": { "$value": "hsl(0, 80%, 42%)", "$type": "color" },
      "900": { "$value": "hsl(0, 80%, 22%)", "$type": "color" }
    },
    "info": {
      "50":  { "$value": "hsl(199, 89%, 96%)", "$type": "color" },
      "500": { "$value": "hsl(199, 89%, 48%)", "$type": "color" },
      "700": { "$value": "hsl(199, 92%, 32%)", "$type": "color" },
      "900": { "$value": "hsl(199, 95%, 16%)", "$type": "color" }
    },
    "aes": {
      "mali": {
        "$comment": "Drapeau Mali — bandes vert / jaune / rouge",
        "green":  { "$value": "hsl(150, 79%, 25%)", "$type": "color" },
        "yellow": { "$value": "hsl(48, 100%, 53%)", "$type": "color" },
        "red":    { "$value": "hsl(2, 78%, 52%)",   "$type": "color" }
      },
      "burkina": {
        "$comment": "Drapeau Burkina Faso — bandes rouge / vert + étoile jaune",
        "red":    { "$value": "hsl(0, 72%, 50%)",   "$type": "color" },
        "green":  { "$value": "hsl(135, 70%, 32%)", "$type": "color" },
        "yellow": { "$value": "hsl(50, 100%, 55%)", "$type": "color" }
      },
      "niger": {
        "$comment": "Drapeau Niger — bandes orange / blanc / vert + cercle orange",
        "orange": { "$value": "hsl(22, 92%, 53%)",  "$type": "color" },
        "white":  { "$value": "hsl(0, 0%, 100%)",   "$type": "color" },
        "green":  { "$value": "hsl(120, 60%, 35%)", "$type": "color" }
      }
    }
  },
  "typography": {
    "family": {
      "sans":    { "$value": "'Inter Variable', system-ui, sans-serif",    "$type": "fontFamily" },
      "display": { "$value": "'Bricolage Grotesque', 'Inter Variable', sans-serif", "$type": "fontFamily" },
      "mono":    { "$value": "'JetBrains Mono Variable', monospace",       "$type": "fontFamily" }
    },
    "size": {
      "$comment": "Échelle modulaire 1.250 (Perfect Fourth), base 16px",
      "xs":   { "$value": "12px", "$type": "dimension" },
      "sm":   { "$value": "14px", "$type": "dimension" },
      "base": { "$value": "16px", "$type": "dimension" },
      "md":   { "$value": "18px", "$type": "dimension" },
      "lg":   { "$value": "20px", "$type": "dimension" },
      "xl":   { "$value": "24px", "$type": "dimension" },
      "2xl":  { "$value": "30px", "$type": "dimension" },
      "3xl":  { "$value": "36px", "$type": "dimension" },
      "4xl":  { "$value": "48px", "$type": "dimension" },
      "5xl":  { "$value": "60px", "$type": "dimension" },
      "6xl":  { "$value": "72px", "$type": "dimension" },
      "7xl":  { "$value": "96px", "$type": "dimension" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium":  { "$value": "500", "$type": "fontWeight" },
      "semibold":{ "$value": "600", "$type": "fontWeight" },
      "bold":    { "$value": "700", "$type": "fontWeight" }
    },
    "leading": {
      "tight":   { "$value": "1.15", "$type": "number" },
      "snug":    { "$value": "1.30", "$type": "number" },
      "normal":  { "$value": "1.50", "$type": "number" },
      "relaxed": { "$value": "1.75", "$type": "number" }
    },
    "tracking": {
      "tighter": { "$value": "-0.04em", "$type": "dimension" },
      "tight":   { "$value": "-0.02em", "$type": "dimension" },
      "normal":  { "$value": "0",       "$type": "dimension" },
      "wide":    { "$value": "0.04em",  "$type": "dimension" }
    }
  },
  "spacing": {
    "$comment": "Échelle 4px stricte — pas de demi-pixels",
    "0":  { "$value": "0",    "$type": "dimension" },
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" },
    "32": { "$value": "128px","$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0",      "$type": "dimension" },
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "base": { "$value": "8px",    "$type": "dimension" },
    "md":   { "$value": "12px",   "$type": "dimension" },
    "lg":   { "$value": "16px",   "$type": "dimension" },
    "xl":   { "$value": "24px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "$comment": "6 niveaux d'élévation, ombres légères (saturation 8%) pour rester sobres",
    "xs":   { "$value": "0 1px 2px 0 hsl(0 0% 0% / 0.04)",                                                   "$type": "shadow" },
    "sm":   { "$value": "0 1px 3px 0 hsl(0 0% 0% / 0.08), 0 1px 2px -1px hsl(0 0% 0% / 0.06)",                "$type": "shadow" },
    "base": { "$value": "0 4px 6px -1px hsl(0 0% 0% / 0.08), 0 2px 4px -2px hsl(0 0% 0% / 0.05)",             "$type": "shadow" },
    "md":   { "$value": "0 10px 15px -3px hsl(0 0% 0% / 0.10), 0 4px 6px -4px hsl(0 0% 0% / 0.06)",           "$type": "shadow" },
    "lg":   { "$value": "0 20px 25px -5px hsl(0 0% 0% / 0.10), 0 8px 10px -6px hsl(0 0% 0% / 0.06)",          "$type": "shadow" },
    "xl":   { "$value": "0 25px 50px -12px hsl(0 0% 0% / 0.18)",                                              "$type": "shadow" },
    "2xl":  { "$value": "0 35px 60px -15px hsl(0 0% 0% / 0.30)",                                              "$type": "shadow" },
    "focus":{ "$value": "0 0 0 3px hsl(213 60% 54% / 0.5)",                                                   "$type": "shadow" }
  },
  "motion": {
    "duration": {
      "instant":  { "$value": "75ms",  "$type": "duration" },
      "xfast":    { "$value": "100ms", "$type": "duration" },
      "fast":     { "$value": "150ms", "$type": "duration" },
      "base":     { "$value": "200ms", "$type": "duration" },
      "slow":     { "$value": "300ms", "$type": "duration" },
      "xslow":    { "$value": "500ms", "$type": "duration" }
    },
    "easing": {
      "linear":     { "$value": "linear",                       "$type": "cubicBezier" },
      "in":         { "$value": "cubic-bezier(0.4, 0, 1, 1)",   "$type": "cubicBezier" },
      "out":        { "$value": "cubic-bezier(0, 0, 0.2, 1)",   "$type": "cubicBezier" },
      "inOut":      { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" },
      "spring":     { "$value": "cubic-bezier(0.32, 0.72, 0, 1)","$type": "cubicBezier" }
    }
  },
  "breakpoints": {
    "$comment": "Mobile-first vrai — on dimensionne d'abord 360px (téléphone bas de gamme malien)",
    "xs":  { "$value": "360px",  "$type": "dimension" },
    "sm":  { "$value": "640px",  "$type": "dimension" },
    "md":  { "$value": "768px",  "$type": "dimension" },
    "lg":  { "$value": "1024px", "$type": "dimension" },
    "xl":  { "$value": "1280px", "$type": "dimension" },
    "2xl": { "$value": "1536px", "$type": "dimension" }
  },
  "z": {
    "base":     { "$value": 0,    "$type": "number" },
    "dropdown": { "$value": 1000, "$type": "number" },
    "sticky":   { "$value": 1100, "$type": "number" },
    "drawer":   { "$value": 1200, "$type": "number" },
    "dialog":   { "$value": 1300, "$type": "number" },
    "popover":  { "$value": 1400, "$type": "number" },
    "tooltip":  { "$value": 1500, "$type": "number" },
    "toast":    { "$value": 1600, "$type": "number" }
  }
}
