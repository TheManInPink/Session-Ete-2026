    "info": {
      "50": { "$value": "hsl(199, 89%, 96%)", "$type": "color" },
      "500": { "$value": "hsl(199, 89%, 48%)", "$type": "color" },
      "700": { "$value": "hsl(199, 92%, 32%)", "$type": "color" },
      "900": { "$value": "hsl(199, 95%, 16%)", "$type": "color" }
    },
    "aes": {
      "mali": {
        "$comment": "Drapeau Mali — bandes vert / jaune / rouge (vert charte §1.1 : #14B53A)",
        "green": { "$value": "hsl(133, 80%, 40%)", "$type": "color" },
        "yellow": { "$value": "hsl(48, 100%, 53%)", "$type": "color" },
        "red": { "$value": "hsl(2, 78%, 52%)", "$type": "color" }
      },
      "burkina": {
        "$comment": "Drapeau Burkina Faso — bandes rouge / vert + étoile jaune (rouge charte §1.1 : #EF3340)",
        "red": { "$value": "hsl(355, 85%, 57%)", "$type": "color" },
        "green": { "$value": "hsl(135, 70%, 32%)", "$type": "color" },
        "yellow": { "$value": "hsl(50, 100%, 55%)", "$type": "color" }
      },
      "niger": {
        "$comment": "Drapeau Niger — bandes orange / blanc / vert + cercle orange (orange charte §1.1 : #FF7F00)",
        "orange": { "$value": "hsl(30, 100%, 50%)", "$type": "color" },
        "white": { "$value": "hsl(0, 0%, 100%)", "$type": "color" },
        "green": { "$value": "hsl(120, 60%, 35%)", "$type": "color" }
      }
    }
