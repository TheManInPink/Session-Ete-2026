      "50": { "$value": "hsl(210, 40%, 98%)", "$type": "color" },
      "100": { "$value": "hsl(210, 40%, 96%)", "$type": "color" },
      "200": { "$value": "hsl(214, 32%, 91%)", "$type": "color" },
      "300": { "$value": "hsl(213, 27%, 84%)", "$type": "color" },
      "400": { "$value": "hsl(215, 20%, 65%)", "$type": "color" },
      "500": { "$value": "hsl(215, 16%, 47%)", "$type": "color" },
      "600": { "$value": "hsl(215, 19%, 35%)", "$type": "color" },
      "700": { "$value": "hsl(215, 25%, 27%)", "$type": "color" },
      "800": { "$value": "hsl(217, 33%, 17%)", "$type": "color" },
      "900": { "$value": "hsl(222, 47%, 11%)", "$type": "color" },
      "950": { "$value": "hsl(229, 63%, 7%)", "$type": "color" }
    },
    "success": {
      "$comment": "Vert (charte §1.1 : #1B7A3D, badge bg #E8F5ED).",
      "50": { "$value": "hsl(140, 40%, 93%)", "$type": "color" },
      "100": { "$value": "hsl(142, 45%, 85%)", "$type": "color" },
      "500": { "$value": "hsl(142, 64%, 38%)", "$type": "color" },
      "700": { "$value": "hsl(142, 64%, 29%)", "$type": "color" },
      "900": { "$value": "hsl(142, 70%, 16%)", "$type": "color" }
