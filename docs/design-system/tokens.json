  "semantic": {
    "$comment": "Rôles sémantiques (mode CLAIR). Émis dans :root et mappés en utilitaires Tailwind via le @theme inline de globals.css. Valeurs = références aux échelles (sortie var(--color-…)).",
    "bg": { "$value": "{color.neutral.50}", "$type": "color" },
    "bg-card": { "$value": "{color.neutral.0}", "$type": "color" },
    "bg-muted": { "$value": "{color.neutral.100}", "$type": "color" },
    "fg": { "$value": "{color.neutral.900}", "$type": "color" },
    "fg-muted": { "$value": "{color.neutral.500}", "$type": "color" },
    "border": { "$value": "{color.neutral.200}", "$type": "color" },
    "ring": { "$value": "{color.accent.500}", "$type": "color" },
    "primary": { "$value": "{color.primary.700}", "$type": "color" },
    "primary-fg": { "$value": "{color.neutral.0}", "$type": "color" },
    "destructive": { "$value": "{color.danger.500}", "$type": "color" },
    "destructive-fg": { "$value": "{color.neutral.0}", "$type": "color" }
  },
  "semanticDark": {
    "$comment": "Surcharges mode SOMBRE — émises dans :root[data-theme='dark'].",
    "bg": { "$value": "{color.neutral.950}", "$type": "color" },
    "bg-card": { "$value": "{color.neutral.900}", "$type": "color" },
    "bg-muted": { "$value": "{color.neutral.800}", "$type": "color" },
    "fg": { "$value": "{color.neutral.100}", "$type": "color" },
    "fg-muted": { "$value": "{color.neutral.400}", "$type": "color" },
    "border": { "$value": "{color.neutral.800}", "$type": "color" },
    "ring": { "$value": "{color.accent.400}", "$type": "color" },
    "primary": { "$value": "{color.primary.500}", "$type": "color" },
    "primary-fg": { "$value": "{color.neutral.50}", "$type": "color" },
    "destructive": { "$value": "{color.danger.500}", "$type": "color" },
    "destructive-fg": { "$value": "{color.neutral.50}", "$type": "color" }
  },
  "typography": {
    "family": {
      "sans": { "$value": "'Inter Variable', system-ui, sans-serif", "$type": "fontFamily" },
      "display": {
        "$value": "'Geist', 'Inter Variable', system-ui, sans-serif",
