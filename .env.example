# ═══════════════════════════════════════════════════════════════
# NINA-AES Platform — Variables d'environnement
# Copier ce fichier vers .env : copy .env.example .env # cmd
# ⚠️  NE JAMAIS commiter le fichier .env (contient des secrets)
#
# Source unique pour le dev local : CE fichier est aussi lu par Docker Compose
# (`make docker-up` utilise `--env-file .env`). Pas besoin de dupliquer les mots de
# passe dans infrastructure/docker/.env.docker sauf préférence (voir .env.docker.example).
# ═══════════════════════════════════════════════════════════════

# ── Environnement ──
NODE_ENV=development
LOG_LEVEL=debug

# ── Base de données PostgreSQL ──
POSTGRES_USER=nina_admin
POSTGRES_PASSWORD=nina_dev_2026!
POSTGRES_DB=nina_aes_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ── Redis ──
REDIS_URL=redis://:redis_dev_2026!@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_2026!

# ── RabbitMQ ──
RABBITMQ_URL=amqp://nina_rabbit:rabbit_dev_2026!@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=nina_rabbit
RABBITMQ_PASSWORD=rabbit_dev_2026!

# ── MinIO (stockage objet S3-compatible) ──
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY = identifiants root du conteneur MinIO (alias MINIO_ROOT_*)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=nina_minio_admin
MINIO_SECRET_KEY=minio_dev_2026!
MINIO_BUCKET_DOCUMENTS=nina-documents
MINIO_BUCKET_PHOTOS=nina-photos

# ── Elasticsearch ──
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_NINA=nina_records
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elastic_dev_2026!
ELASTIC_PASSWORD=elastic_dev_2026!
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ── Kibana (Fleet / SavedObjects encryption — dev keys, ≥32 chars) ──
# Générer en prod : `openssl rand -hex 32` (chacune doit rester stable entre redémarrages,
# sinon les objets sauvegardés chiffrés deviennent illisibles).
KIBANA_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-AAAAAAAAAAAAAAAAAAAAAAAA
KIBANA_SECURITY_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-BBBBBBBBBBBBBBBBBBBBBBBB
KIBANA_REPORTING_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-CCCCCCCCCCCCCCCCCCCCCCCC

# ── Keycloak (OAuth2 / OIDC) ──
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nina-aes
KEYCLOAK_CLIENT_ID=nina-aes-platform
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_2026!
# Variables Keycloak en conteneur (même fichier ; KC_DB_* utilisent POSTGRES_* par défaut dans docker-compose)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_HOSTNAME=localhost
KC_HTTP_ENABLED=true

# ── HashiCorp Vault ──
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=CHANGER_CE_TOKEN_VAULT

# ── JWT (RS256) ──
JWT_SECRET=dev-jwt-secret-change-this-in-production-minimum-32-characters
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400

# ── Ports des microservices NestJS ──
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
AUTH_SERVICE_PORT=3002
AI_SERVICE_PORT=3003
DOCUMENT_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
INTEROP_SERVICE_PORT=3006
AUDIT_SERVICE_PORT=3007
APPOINTMENT_SERVICE_PORT=3008
ANTICORRUPTION_SERVICE_PORT=3009
GOVERNANCE_SERVICE_PORT=3010
VULNERABILITY_SERVICE_PORT=3011
BIOMETRIC_SERVICE_PORT=3012
ENROLLMENT_SERVICE_PORT=3013
USSD_SERVICE_PORT=3014

# ── Ports des frontends Next.js (citizen 4001, admin 4002, governance 4003) ──
CITIZEN_PORT=4001
ADMIN_PORT=4002
GOVERNANCE_PORT=4003

# ── URLs publiques (front) ──
# Les 3 apps Next.js passent par le gateway (:3000) via leur .env.local
# (API_BASE_URL / NEXT_PUBLIC_GATEWAY_URL). Les anciennes NEXT_PUBLIC_API/AUTH/AI_URL
# (accès direct aux services, hors gateway) étaient mortes (0 référence) → retirées.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080

# ── Africa's Talking (USSD / SMS) ──
AT_API_KEY=sandbox-api-key
AT_USERNAME=sandbox
AT_USSD_SHORTCODE=*123*NINA#
AT_SMS_SENDER_ID=NINA-AES

# ── Authenticité du webhook USSD (P0 sécurité, doc 14 §4.2) ──
# CSV des IP sortantes autorisées des passerelles Africa's Talking / opérateur.
# Vide en dev (guard permissif) ; REQUIS en production (fail-closed sinon).
AT_GATEWAY_IP_ALLOWLIST=
# Secret partagé attendu dans l'en-tête X-AT-Webhook-Secret (comparé en temps
# constant). Vit dans Vault en prod — ne JAMAIS committer une vraie valeur ici.
AT_WEBHOOK_SHARED_SECRET=
# Nombre de reverse-proxys de CONFIANCE devant ussd-service (Express trust proxy).
# X-Real-IP n'est honoré que via un proxy de confiance (anti-usurpation). En
# production, ussd-service refuse de démarrer si < 1. Dev local sans proxy : 0.
TRUST_PROXY_HOPS=0

# ── Orange Mali API (SMS) ──
ORANGE_MALI_API_KEY=change-me

# ── SMTP (développement via Maildev) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nina-aes.ml

# ── AES — Certificats mTLS inter-pays ──
AES_MLI_CERT_PATH=./secrets/aes/mali.crt
AES_MLI_KEY_PATH=./secrets/aes/mali.key
AES_BFA_CERT_PATH=./secrets/aes/burkina.crt
AES_NER_CERT_PATH=./secrets/aes/niger.crt
AES_CA_PATH=./secrets/aes/aes-ca.crt

# ── Module IA ──
AI_AUTO_THRESHOLD=85.0
AI_REVIEW_THRESHOLD=60.0
AI_BATCH_SIZE=1000
AI_XGBOOST_MODEL_PATH=./ai-models/trained/xgboost_nina.json

# ── SIGAC (Anti-corruption) ──
SIGAC_INTEGRITY_CRITICAL=40.0
SIGAC_INTEGRITY_WARNING=60.0
