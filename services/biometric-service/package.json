{
  "name": "@nina-aes/biometric-service",
  "version": "0.1.0",
  "private": true,
  "description": "Microservice biométrie (Bloc F, port 3012) — protection de template ISO/IEC 24745 (cancelable biometrics, distance-préservante), vérification 1:1 par distance + seuil τ (boucle sans court-circuit), consentement JWS Ed25519 ancré, rotation double-écriture, gate DPIA/RGPD bloquant en prod. JAMAIS d'image brute ni de template en clair.",
  "keywords": [
    "nina",
    "aes",
    "platform",
    "biometric-service",
    "nestjs",
    "biometrics",
    "iso-24745",
    "cancelable",
    "consent"
  ],
  "author": "Étudiant UQAR",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --config ./test/jest.config.ts --passWithNoTests",
    "test:watch": "jest --config ./test/jest.config.ts --watch",
    "test:cov": "jest --config ./test/jest.config.ts --coverage --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo"
  },
