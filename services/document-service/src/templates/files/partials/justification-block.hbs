<section class="justification">
  <p class="just-text">{{t "fdi.justification.body"}}</p>
  <p>
    <strong>{{t "fdi.justification.fdiNumber"}} :</strong>
    {{document.serialNumber}}
  </p>
  <p>
    <strong>{{t "fdi.issuedOn"}} :</strong>
    {{formatDate document.issuedAt language}}
  </p>
</section>
