<header class="ctdec-header">
  <div class="ctdec-logo" aria-hidden="true">⚜</div>
  <div class="ctdec-titles">
    <h2 class="ctdec-name">CTDEC</h2>
    <p class="ctdec-fullname">{{t "ctdec.fullName"}}</p>
    <p class="ctdec-address">{{t "ctdec.address"}}</p>
  </div>
  <div class="ctdec-republic">
    <p>{{t "republic.name"}}</p>
    <p class="motto">{{t "republic.motto"}}</p>
  </div>
</header>
