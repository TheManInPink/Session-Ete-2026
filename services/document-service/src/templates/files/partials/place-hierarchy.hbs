<table class="place-hierarchy">
  <tr>
    <th>{{t "fdi.country.code"}}</th>
    <td>{{countryCode}}</td>
    <th>{{t "fdi.country"}}</th>
    <td>{{country}}</td>
  </tr>
  <tr>
    <th>{{t "fdi.region"}}</th>
    <td>{{region}}</td>
    <th>{{t "fdi.cercle"}}</th>
    <td>{{cercle}}</td>
  </tr>
  <tr>
    <th>{{t "fdi.arrondissement"}}</th>
    <td>{{arrondissement}}</td>
    <th>{{t "fdi.commune"}}</th>
    <td>{{commune}}</td>
  </tr>
  <tr>
    <th>{{t "fdi.quartier"}}</th>
    <td>{{quartier}}</td>
    <th>{{t "fdi.fraction"}}</th>
    <td>{{fraction}}</td>
  </tr>
  <tr>
    <th>{{t "fdi.hameau"}}</th>
    <td>{{hameau}}</td>
    <th>{{t "fdi.secteur"}}</th>
    <td>{{secteur}}</td>
  </tr>
</table>
