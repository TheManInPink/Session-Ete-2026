# ═══════════════════════════════════════════════════════════════════
# @nina-aes/api-gateway — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════
# Copier vers .env et adapter à votre environnement local.
# Validation fail-fast au démarrage via src/config/env.schema.ts (Zod).
# NB : ConfigModule charge `../../.env` (racine) PUIS ce `.env` — la racine
#      gagne pour les variables partagées (REDIS_URL, LOG_LEVEL, …). Ne (re)définir
#      ici que les variables SPÉCIFIQUES au gateway (URLs aval, secret HS256, JWKS).
# En production : GATEWAY_HS256_SECRET servi via Vault (cf. doc 15 + ADR-019).

# ─── Application ────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_VERSION=1.0.0
LOG_LEVEL=info

# Port d'écoute HTTP
API_GATEWAY_PORT=3000

# CORS origins (apps Next.js) — JAMAIS de wildcard en prod
CORS_ORIGINS=http://localhost:4001,http://localhost:4002,http://localhost:4003

# ─── Authentification (JWT RS256 vérifié via le JWKS d'auth-service) ─
AUTH_JWKS_URL=http://localhost:3002/.well-known/jwks.json
# false = n'exige PAS de JWT (UNIQUEMENT pour bancs de test isolés)
AUTH_REQUIRED=true

# ─── Contexte utilisateur signé propagé aux avals (X-User-Context, JWS HS256) ─
# ⚠️ dev only — en prod servi via Vault. Le boot REFUSE ce défaut si NODE_ENV=production.
GATEWAY_HS256_SECRET=dev-gateway-hs256-secret-change-in-prod-min-32-chars
GATEWAY_USER_CONTEXT_TTL_SEC=60

# ─── Redis (rate limiting distribué) ────────────────────────────────
REDIS_URL=redis://:redis_dev_2026!@localhost:6379
REDIS_KEY_PREFIX=gateway:

# ─── Rate limiting (fenêtre glissante, par identité user|IP) ────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=100

# ─── Swagger agrégé ─────────────────────────────────────────────────
SWAGGER_AGGREGATE_TTL_SEC=300
SWAGGER_AGGREGATE_FETCH_TIMEOUT_MS=1500
SWAGGER_AGGREGATE_ON_BOOT=false

# ─── Observabilité ──────────────────────────────────────────────────
OTEL_TRACING_ENABLED=false
LOKI_URL=http://localhost:3100

# ─── URLs des 14 services aval ──────────────────────────────────────
# Défauts du schéma = noms d'hôtes Docker Compose (http://identity-service:3001, …).
# En LOCAL (hors Docker), pointer sur localhost pour les services que vous lancez :
IDENTITY_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
AI_SERVICE_URL=http://localhost:3003
DOCUMENT_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
INTEROP_SERVICE_URL=http://localhost:3006
AUDIT_SERVICE_URL=http://localhost:3007
APPOINTMENT_SERVICE_URL=http://localhost:3008
ANTICORRUPTION_SERVICE_URL=http://localhost:3009
GOVERNANCE_SERVICE_URL=http://localhost:3010
VULNERABILITY_SERVICE_URL=http://localhost:3011
BIOMETRIC_SERVICE_URL=http://localhost:3012
ENROLLMENT_SERVICE_URL=http://localhost:3013
USSD_SERVICE_URL=http://localhost:3014
