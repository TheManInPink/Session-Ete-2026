# ═══════════════════════════════════════════════════════════════════
# @nina-aes/auth-service — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════
# Copier vers .env et adapter à votre environnement local.
# En production : valeurs servies via Vault AppRole (cf. doc 15 + ADR-019).

# ─── Application ────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=auth-service
SERVICE_VERSION=0.1.0
ENV=dev
LOG_LEVEL=info

# Port d'écoute HTTP
AUTH_SERVICE_PORT=3002

# CORS origins (apps Next.js)
CORS_ORIGINS=http://localhost:4001,http://localhost:4002,http://localhost:4003

# ─── PostgreSQL (via @nina-aes/database) ────────────────────────────
DATABASE_URL=postgresql://nina_admin:nina_dev_2026!@localhost:5432/nina_aes_db?schema=public

# ─── Redis (refresh tokens, OTP, reset jti, MFA secrets) ────────────
REDIS_URL=redis://:redis_dev_2026!@localhost:6379
REDIS_KEY_PREFIX=auth:

# ─── Keycloak (SSO + JWKS proxy + realm import) ─────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nina-aes
KEYCLOAK_CLIENT_ID=nina-aes-platform
KEYCLOAK_CLIENT_SECRET=keycloak-client-dev-secret
# Admin Keycloak utilisé uniquement pour le bootstrap realm en dev.
# En prod : Vault kv/data/keycloak/admin.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_2026!

# ─── JWT (clés RS256 chargées depuis Vault au boot) ─────────────────
# Path Vault des clés : VAULT_JWT_KEYS_PATH (KV v2).
# La forme attendue dans le secret : { "private_pem": "...", "public_pem": "..." }
VAULT_JWT_KEYS_PATH=kv/data/auth/jwt
JWT_ISSUER=https://auth.nina-aes.local
JWT_AUDIENCE=nina-aes-platform
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_RESET_TTL_SECONDS=900

# ─── Vault (cf. @nina-aes/vault-client) ─────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_AUTH_METHOD=token
VAULT_TOKEN=nina-dev
# Pour AppRole en prod :
# VAULT_AUTH_METHOD=approle
# VAULT_APPROLE_ROLE_ID=
# VAULT_APPROLE_SECRET_ID=

# ─── Argon2id (paramètres OWASP — ne pas baisser sans benchmark) ────
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# ─── MFA TOTP (otplib) ──────────────────────────────────────────────
MFA_TOTP_ISSUER=NINA-AES
# Fenêtre de validation : ±1 pas de 30s (1 = 30s avant/après le code courant).
MFA_TOTP_WINDOW=1

# ─── SMS (Africa's Talking — OTP register + MFA SMS) ────────────────
# MOCK_SMS=true (défaut dev) : le code est loggé en console au lieu d'être envoyé.
# Passer à false en sandbox/prod avec les credentials Africa's Talking.
MOCK_SMS=true
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=NINAAES

# ─── Rate limit /auth/login (anti-bruteforce OWASP ASVS V11.1) ─────
# 5 tentatives toutes les 900 s (15 min) par IP. Réinitialisé sur login réussi.
THROTTLE_LOGIN_TTL_SECONDS=900
THROTTLE_LOGIN_LIMIT=5

# ─── Observabilité (cf. @nina-aes/observability) ────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOKI_URL=http://localhost:3100
PROMETHEUS_ENABLED=true
