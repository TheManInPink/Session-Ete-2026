# ═══════════════════════════════════════════════════════════════════
# @nina-aes/identity-service — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════
# Copier vers .env et adapter à votre environnement local.
# En production : valeurs servies via Vault AppRole (cf. doc 15 + ADR-019).

# ─── Application ────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=identity-service
SERVICE_VERSION=0.1.0
ENV=dev
LOG_LEVEL=info

# Port d'écoute HTTP
IDENTITY_SERVICE_PORT=3001

# CORS origins (apps Next.js)
CORS_ORIGINS=http://localhost:4001,http://localhost:4002,http://localhost:4003

# ─── PostgreSQL (via @nina-aes/database) ────────────────────────────
DATABASE_URL=postgresql://nina_admin:nina_dev_2026!@localhost:5432/nina_aes_db?schema=public

# ─── Redis (cache + sessions) ───────────────────────────────────────
REDIS_URL=redis://:redis_dev_2026!@localhost:6379
REDIS_CACHE_TTL_SECONDS=300
REDIS_KEY_PREFIX=identity:

# ─── RabbitMQ (événements citizen.created, correction.submitted, etc.) ─
RABBITMQ_URL=amqp://nina_rabbit:rabbit_dev_2026!@localhost:5672
RABBITMQ_EXCHANGE=nina-aes.events
RABBITMQ_EXCHANGE_TYPE=topic

# ─── Services externes (URLs internes du cluster) ───────────────────
AI_SERVICE_URL=http://localhost:3003
SIGAC_SERVICE_URL=http://localhost:3009
AUDIT_SERVICE_URL=http://localhost:3007
DOCUMENT_SERVICE_URL=http://localhost:3004

# Mode mock pour les services externes (dev uniquement — laisse passer si KO)
MOCK_EXTERNAL_SERVICES=true

# ─── Auth ──────────────────────────────────────────────────────────
# En prod : récupéré depuis Vault kv/data/jwt/public
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
# En mode dev mock, on accepte n'importe quel token (ROLE par défaut: AGENT)
NINA_AUTH_MODE=mock

# ─── Vault (cf. @nina-aes/vault-client) ─────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_AUTH_METHOD=token
VAULT_TOKEN=nina-dev
# Pour AppRole en prod :
# VAULT_AUTH_METHOD=approle
# VAULT_APPROLE_ROLE_ID=
# VAULT_APPROLE_SECRET_ID=

# ─── Observabilité (cf. @nina-aes/observability) ────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOKI_URL=http://localhost:3100
PROMETHEUS_ENABLED=true

# ─── Rate limiting (Throttler global) ───────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
