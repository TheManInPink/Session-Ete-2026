# ═══════════════════════════════════════════════════
# NINA-AES Platform — .gitignore
# ═══════════════════════════════════════════════════

# ── Dépendances ──
node_modules/
.pnp
.pnp.js

# ── Variables d'environnement (JAMAIS commiter de secrets) ──
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example

# ── Build outputs ──
.next/
out/
build/
dist/
*.tsbuildinfo

# ── Turbo ──
.turbo/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/

# ── Docker ──
docker-compose.override.yml

# ── IDE ──
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── Tests ──
coverage/
.nyc_output/
test-results/
playwright-report/

# ── Sécurité (ne jamais commiter) ──
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
vault-data/

# ── IA / Modèles entraînés (trop lourds pour Git) ──
ai-models/trained/*.json
ai-models/trained/*.pkl
ai-models/trained/*.joblib
!ai-models/trained/.gitkeep

# ── Données ──
*.sql.bak
*.dump

# ── MinIO data locale ──
minio-data/

# ── Vercel ──
.vercel/
