{
  "realm": "nina-aes",
  "displayName": "NINA-AES",
  "displayNameHtml": "<b>NINA-AES</b> — Plateforme État Civil Mali",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and notEmail and passwordHistory(5)",
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "roles": {
    "realm": [
      {
        "name": "citizen",
        "description": "Citoyen — accès self-service (état civil, RDV, vulnérabilité)",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "agent",
        "description": "Agent guichet — traitement des dossiers + RDV",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "supervisor",
        "description": "Superviseur — validation 4-yeux + audit local",
        "composite": true,
        "composites": {
          "realm": ["agent"]
        },
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Administrateur national — configuration + comptes",
        "composite": true,
        "composites": {
          "realm": ["supervisor"]
        },
        "clientRole": false
      },
      {
        "name": "auditor",
        "description": "Auditeur — lecture seule des journaux d'audit",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "anticorruption_inspector",
        "description": "Inspecteur anti-corruption — accès alertes + journaux",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": ["citizen"],
  "defaultRole": {
    "name": "default-roles-nina-aes",
    "description": "${role_default-roles}",
    "composite": true,
    "composites": {
      "realm": ["citizen", "offline_access", "uma_authorization"]
    },
    "clientRole": false,
    "containerId": "nina-aes"
  },
  "clients": [
    {
      "clientId": "nina-aes-platform",
      "name": "NINA-AES Platform (auth-service)",
      "description": "Client confidentiel utilisé par auth-service pour le password grant + client_credentials.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "keycloak-client-dev-secret",
      "clientAuthenticatorType": "client-secret",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:3002",
      "baseUrl": "http://localhost:3002",
      "redirectUris": [
        "http://localhost:3002/*",
        "http://localhost:4001/*",
        "http://localhost:4002/*",
        "http://localhost:4003/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "access.token.lifespan": "900",
        "client.secret.creation.time": "1700000000",
        "post.logout.redirect.uris": "+",
        "use.refresh.tokens": "true",
        "client.use.lightweight.access.token.enabled": "false"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "nina-citizen",
      "name": "NINA-AES Citizen (app frontend — PKCE public)",
      "description": "Client PUBLIC (Authorization Code + PKCE S256) de l'app citizen Next.js (BFF). redirect_uri = /api/auth/callback.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:4001",
      "baseUrl": "http://localhost:4001",
      "redirectUris": ["http://localhost:4001/api/auth/callback"],
      "webOrigins": ["http://localhost:4001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4001/*",
        "use.refresh.tokens": "true",
        "client.use.lightweight.access.token.enabled": "false"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
      "protocolMappers": [
        {
          "name": "nina-attribute",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "nina",
            "claim.name": "nina",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "audience-nina-citizen",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "nina-citizen",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-nina-aes-platform",
      "enabled": true,
      "serviceAccountClientId": "nina-aes-platform",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm",
          "view-clients",
          "manage-clients"
        ]
      }
    },
    {
      "username": "citoyen.demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Fatoumata",
      "lastName": "Diallo",
      "email": "fatoumata.diallo@nina-aes.demo",
      "attributes": {
        "nina": ["18903102015042V"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "Citizen-Dev-2026!",
          "temporary": false
        }
      ],
      "realmRoles": ["citizen"]
    }
  ],
  "scopeMappings": [],
  "smtpServer": {},
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_PASSWORD_ERROR",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "REFRESH_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
