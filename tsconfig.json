{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "@nina-aes/shared-types": ["./packages/shared-types/src"],
      "@nina-aes/database": ["./packages/database/src"],
      "@nina-aes/config": ["./packages/config/src"],
      "@nina-aes/utils": ["./packages/utils/src"],
      "@nina-aes/ui": ["./packages/ui-components/src"]
    }
  },
  "include": ["scripts/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "coverage",
    "apps",
    "packages",
    "services"
  ]
}
