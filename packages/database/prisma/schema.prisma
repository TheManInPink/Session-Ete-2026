// ──────────────────────────────────────────────────────────────────────────────
//  16. NOTIFICATIONS — notification-service (multicanal)
// ──────────────────────────────────────────────────────────────────────────────

/// Notification transactionnelle (SMS, push, email, USSD callback, voix).
model Notification {
  id                 String    @id @default(uuid()) @db.Uuid
  recipientUserId    String?   @map("recipient_user_id") @db.Uuid
  recipientCitizenId String?   @map("recipient_citizen_id") @db.Uuid
  /// Canal : SMS, PUSH, EMAIL, USSD, VOICE.
  channel            String    @db.VarChar(20)
  /// Statut : PENDING, SENT, DELIVERED, FAILED, READ.
  status             String    @default("PENDING") @db.VarChar(20)
  templateKey        String    @map("template_key") @db.VarChar(100)
  language           Language  @default(FR)
  payload            Json
  /// Clé d'idempotence : SHA-256(recipient | channel | templateKey | payload canonique).
  /// Nullable → les envois en masse non idempotents (broadcast) gardent NULL
  /// (Postgres autorise plusieurs NULL sous un index UNIQUE). Un doublon
  /// transactionnel (retry at-least-once) lève P2002 → renvoi de l'existant.
  dedupeKey          String?   @unique @map("dedupe_key") @db.VarChar(64)
  providerId         String?   @map("provider_id") @db.VarChar(100)
  sentAt             DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz(6)
  failureReason      String?   @map("failure_reason") @db.Text
  retryCount         Int       @default(0) @map("retry_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipientUser    User?    @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  recipientCitizen Citizen? @relation(fields: [recipientCitizenId], references: [id], onDelete: Restrict)

  @@index([recipientUserId])
  @@index([recipientCitizenId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("notifications")
}

// ──────────────────────────────────────────────────────────────────────────────
//  17. DOCUMENTS — Fiche Descriptive Individuelle (PDF + QR JWT RS256)
// ──────────────────────────────────────────────────────────────────────────────

/// Type de document généré par `document-service`.
enum DocumentType {
  FICHE_DESCRIPTIVE
  EXTRAIT_NAISSANCE
  CERTIFICAT_NATIONALITE
}

/// Motif de révocation d'un document émis.
enum DocumentRevocationReason {
  DECEASED
  FRAUD_DETECTED
  DATA_CORRECTION
  CITIZEN_REQUEST
  OTHER
}

/// Action journalisée sur un document (download, vérification QR).
enum DocumentAccessAction {
  DOWNLOAD
  VERIFY_QR
}

/// Résultat d'une action sur un document.
enum DocumentAccessResult {
  SUCCESS
  FAILURE
}

/// Document émis (FDI principalement). Append-only — toute mise à jour
/// passe par une nouvelle ligne + révocation de l'ancienne.
model Document {
  id             String       @id @default(uuid()) @db.Uuid
  /// Identifiant unique du JWT QR (UUID v7). Clé de révocation O(1).
  jti            String       @unique @db.Uuid
  /// NINA du citoyen (dénormalisé pour découpler du cycle de vie Citizen).
  nina           String       @db.VarChar(15)
  type           DocumentType @default(FICHE_DESCRIPTIVE)
  /// Numéro de souche imprimé sur le PDF (FDI-YYYY-NNNNNNN).
  serialNumber   String       @unique @map("serial_number") @db.VarChar(32)
  /// Code ISO 639-3 de la langue rendue (fra, bam, snk, fuv).
  language       String       @db.VarChar(3)
  /// SHA-256 du HTML source rendu (canonical, avant Puppeteer).
  sha256Html     String       @map("sha256_html") @db.VarChar(64)
  /// SHA-256 du PDF final (après pdf-lib post-process).
  sha256Pdf      String       @map("sha256_pdf") @db.VarChar(64)
  /// Key id Vault Transit qui a signé le QR (`nina-qr-signing-vN`).
  kid            String       @db.VarChar(64)
  minioBucket    String       @default("fiches") @map("minio_bucket") @db.VarChar(64)
  minioObjectKey String       @map("minio_object_key") @db.VarChar(256)
  minioVersionId String?      @map("minio_version_id") @db.VarChar(64)
  issuedAt       DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  /// userId Keycloak qui a déclenché l'émission (agent ou self-service).
  issuedBy       String       @map("issued_by") @db.Uuid
  issuedFromIp   String       @map("issued_from_ip") @db.VarChar(45)
  /// Watermark court (12 chars de SHA-256(ip|userAgent|jti)) imprimé en filigrane.
  watermark      String       @db.VarChar(16)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  revocation DocumentRevocation?
  accessLogs DocumentAccessLog[]

  @@index([nina, type])
  @@index([issuedAt])
  @@index([expiresAt])
  @@map("documents")
}

/// Révocation d'un document (1 ligne par jti révoqué, append-only).
model DocumentRevocation {
  id         String                   @id @default(uuid()) @db.Uuid
  documentId String                   @unique @map("document_id") @db.Uuid
  reason     DocumentRevocationReason
  reasonText String?                  @map("reason_text") @db.Text
  revokedAt  DateTime                 @default(now()) @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String                   @map("revoked_by") @db.Uuid

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@map("document_revocations")
}

/// Journal d'accès à un document (download + vérification QR).
/// Append-only — sert d'audit local en complément de l'audit Merkle global.
model DocumentAccessLog {
  id         String               @id @default(uuid()) @db.Uuid
  documentId String?              @map("document_id") @db.Uuid
  action     DocumentAccessAction
  /// Pour VERIFY_QR sans documentId (si le jti n'existe pas en base — anti-fraude).
  jti        String?              @db.Uuid
  ipAddress  String               @map("ip_address") @db.VarChar(45)
  userAgent  String?              @map("user_agent") @db.VarChar(500)
  result     DocumentAccessResult
  /// VALID | EXPIRED | REVOKED | HASH_MISMATCH | BAD_SIGNATURE | BAD_CLAIM | INVALID
  reasonCode String?              @map("reason_code") @db.VarChar(32)
  occurredAt DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(6)

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([jti])
  @@index([occurredAt])
  @@index([action, result])
  @@map("document_access_logs")
}

// ──────────────────────────────────────────────────────────────────────────────
//  18. ENROLLMENT_CENTERS — profil opérationnel des centres (appointment-service)
// ──────────────────────────────────────────────────────────────────────────────

/// Profil opérationnel d'un centre d'enrôlement, rattaché 1:1 à une
/// `Institution` (CTDEC, mairie, antenne mobile RAVEC). Sépare les paramètres
/// d'exploitation (horaires, capacité, quotas, fenêtre prioritaire, géo) de
/// l'identité institutionnelle partagée (table `institutions`). Les `Appointment`
/// référencent toujours l'`Institution` (`centerId` = `institution_id`) ; ce
/// modèle ne porte QUE la configuration de prise de rendez-vous.
///
/// Pourquoi un modèle dédié plutôt que des colonnes sur `Institution` : éviter
/// de polluer une table partagée par 4 services (users, gouvernance, audit) avec
/// des champs spécifiques aux RDV, et garder les quotas/horaires modifiables par
/// un admin sans redéploiement (source de vérité en base — cf. ADR appointment).
model EnrollmentCenter {
  id              String   @id @default(uuid()) @db.Uuid
  /// Institution hôte (1:1). Unique : une institution = au plus un profil centre.
  institutionId   String   @unique @map("institution_id") @db.Uuid
  /// Services offerts au guichet : ENROLLMENT, CORRECTION, DOCUMENT_PICKUP, …
  servicesOffered String[] @map("services_offered")
  /// Capacité totale de RDV servis par jour (toutes files confondues).
  capacityPerDay  Int      @map("capacity_per_day")
  /// Durée d'un créneau en minutes (pas de la grille horaire).
  slotDurationMin Int      @map("slot_duration_min")
  /// Nombre de guichets servant en parallèle (estimation du temps d'attente).
  parallelDesks   Int      @default(1) @map("parallel_desks")
  /// Quota de créneaux STANDARD par jour.
  standardQuota   Int      @map("standard_quota_per_day")
  /// Quota de créneaux PRIORITAIRES par jour (personnes vulnérables).
  priorityQuota   Int      @map("priority_quota_per_day")
  /// Début de la fenêtre prioritaire réservée aux vulnérables (HH:mm, ex "07:00").
  priorityFrom    String   @map("priority_window_from") @db.VarChar(5)
  /// Fin de la fenêtre prioritaire (HH:mm, ex "09:00").
  priorityTo      String   @map("priority_window_to") @db.VarChar(5)
  /// Horaires d'ouverture par jour de semaine :
  /// `{ "mon": ["08:00","16:00"], "tue": [...], ..., "sat": [...], "sun": null }`.
  /// `null`/absent ⇒ fermé ce jour-là.
  openingHours    Json     @map("opening_hours")
  /// Latitude WGS84 (recherche du centre le plus proche — Haversine applicatif).
  latitude        Decimal  @db.Decimal(10, 7)
  /// Longitude WGS84.
  longitude       Decimal  @db.Decimal(10, 7)
  /// Fuseau horaire IANA. Le Mali est à UTC+0 toute l'année (pas de DST).
  timezone        String   @default("Africa/Bamako") @db.VarChar(40)
  /// Centre ouvert aux nouvelles prises de RDV (désactivable sans suppression).
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([isActive])
  @@map("enrollment_centers")
}

// ══════════════════════════════════════════════════════════════════════════════
//  BLOC C1 — VULNERABILITY-SERVICE (port 3011) — extensions ADDITIVES (doc 22)
//
//  Trois sous-domaines, tous greffés sur les modèles existants (Citizen, User,
//  VulnerabilityRecord) sans en altérer la sémantique :
//    1. File prioritaire d'enrôlement  → PriorityQueueEntry
//    2. Agents mobiles d'enrôlement     → MobileAgent
//    3. Lots d'enrôlement hors-ligne    → OfflineEnrollmentBatch (+ Record)
//
//  Le PROFIL VULNÉRABLE (catégorie particulière, RGPD-like) réutilise l'enum
//  `VulnerabilityCategory` et le modèle `VulnerabilityRecord` déjà présents.
// ══════════════════════════════════════════════════════════════════════════════

/// Statut opérationnel d'un agent mobile d'enrôlement.
enum MobileAgentStatus {
  /// Recruté mais pas encore activé sur le terrain.
  PENDING
  /// Actif, peut collecter des enrôlements / visites à domicile.
  ACTIVE
  /// Suspendu temporairement (enquête, congé, sanction).
  SUSPENDED
  /// Désactivé définitivement (fin de mission).
  RETIRED

  @@map("mobile_agent_status")
}

/// Statut de traitement d'un lot d'enrôlement collecté hors-ligne.
enum OfflineBatchStatus {
  /// Reçu, signature/horodatage validés, en attente de revue agent CTDEC.
  RECEIVED
  /// En cours de traitement (création des fiches citoyens).
  PROCESSING
  /// Intégralement traité (toutes les fiches importées).
  COMPLETED
  /// Rejeté (signature invalide, lot expiré au-delà du cache 5 jours, doublon).
  REJECTED
  /// Partiellement traité (certaines fiches en erreur, quarantaine).
  PARTIAL

  @@map("offline_batch_status")
}

/// Statut d'une fiche individuelle au sein d'un lot offline.
enum OfflineRecordStatus {
  PENDING
  IMPORTED
  DUPLICATE
  INVALID

  @@map("offline_record_status")
}

// ──────────────────────────────────────────────────────────────────────────────
//  C1.1 — PRIORITY_QUEUE_ENTRIES — file prioritaire d'enrôlement (P1>P2>P3)
// ──────────────────────────────────────────────────────────────────────────────

/// Entrée de file prioritaire pour l'enrôlement d'un citoyen vulnérable.
///
/// Le `priorityWeight` (1–5) est dérivé de la catégorie de vulnérabilité au
/// moment du calcul (cf. doc 22 §3). Le `priorityScore` matérialise le rang :
/// plus il est élevé, plus l'entrée passe tôt. La file est consommée par
/// l'appointment-service (créneaux PRIORITAIRES) — pas de FK cross-service :
/// `appointmentId` est un simple identifiant nullable (lecture seule partagée).
model PriorityQueueEntry {
  id             String                @id @default(uuid()) @db.Uuid
  citizenId      String                @map("citizen_id") @db.Uuid
  /// Catégorie ayant motivé la priorité (snapshot — la fiche peut expirer ensuite).
  category       VulnerabilityCategory
  /// Niveau P1/P2/P3 (aligné enum `PriorityLevel`).
  priority       PriorityLevel         @default(P3)
  /// Poids 1–5 dérivé de la catégorie (déterminisme du calcul).
  priorityWeight Int                   @map("priority_weight")
  /// Score de rang = priorityWeight * 1000 − âge(s) — recalculable, persisté pour tri.
  priorityScore  Int                   @map("priority_score")
  /// RDV éventuellement attaché (appointment-service) — pas de FK cross-domaine.
  appointmentId  String?               @map("appointment_id") @db.Uuid
  /// Centre d'enrôlement visé (Institution.id) — optionnel à l'inscription en file.
  centerId       String?               @map("center_id") @db.Uuid
  /// File active tant que non servie/expirée (cf. `servedAt`).
  active         Boolean               @default(true)
  enqueuedAt     DateTime              @default(now()) @map("enqueued_at") @db.Timestamptz(6)
  servedAt       DateTime?             @map("served_at") @db.Timestamptz(6)
  /// Acteur ayant inscrit le citoyen en file (User.id ou origine système).
  enqueuedBy     String                @map("enqueued_by") @db.VarChar(100)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Restrict)

  /// Un citoyen ne peut avoir qu'UNE entrée active à la fois (anti-doublon de file).
  @@unique([citizenId, active], name: "uniq_active_queue_entry")
  @@index([active, priorityScore(sort: Desc)])
  @@index([centerId, active])
  @@index([category])
  @@map("priority_queue_entries")
}

// ──────────────────────────────────────────────────────────────────────────────
//  C1.2 — MOBILE_AGENTS — agents d'enrôlement mobiles (atteindre les isolés)
// ──────────────────────────────────────────────────────────────────────────────

/// Agent mobile d'enrôlement : se déplace pour atteindre les personnes isolées
/// (handicap, grand âge, zones rurales). Rattaché à un `User` (compte agent) et
/// affecté à des zones administratives (codes Location libres : région/cercle/
/// commune). Le statut pilote l'éligibilité opérationnelle.
model MobileAgent {
  id           String            @id @default(uuid()) @db.Uuid
  /// Compte utilisateur (rôle AGENT) — 1:1, unique.
  userId       String            @unique @map("user_id") @db.Uuid
  /// Matricule terrain (badge), unique et lisible.
  badgeNumber  String            @unique @map("badge_number") @db.VarChar(40)
  status       MobileAgentStatus @default(PENDING)
  /// Zones d'intervention (codes administratifs libres : "ML-7", "Kayes", …).
  zones        String[]
  /// Téléphone terrain (rappels/sync) — peut différer du compte User.
  phoneNumber  String?           @map("phone_number") @db.VarChar(20)
  /// Clé publique du kit (PEM SPKI) servant à VÉRIFIER la signature détachée des
  /// lots offline collectés par cet agent (non-répudiation du canal hors-ligne).
  /// `null` tant que le kit n'a pas été appairé : un lot reçu d'un agent sans clé
  /// est REJETÉ (fail-closed), jamais scellé sans preuve cryptographique.
  publicKeyPem String?           @map("public_key_pem") @db.Text
  /// Algorithme de signature associé à `publicKeyPem` (défaut : RSA-SHA256).
  signatureAlg String?           @map("signature_alg") @db.VarChar(40)
  /// Dernière synchronisation réussie (cache offline 5 jours).
  lastSyncAt   DateTime?         @map("last_sync_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  collectedBatches OfflineEnrollmentBatch[] @relation("BatchMobileAgent")

  @@index([status])
  @@index([zones])
  @@map("mobile_agents")
}

// ──────────────────────────────────────────────────────────────────────────────
//  C1.3 — OFFLINE_ENROLLMENT_BATCHES — kits hors-ligne (inclusion numérique)
// ──────────────────────────────────────────────────────────────────────────────

/// Lot d'enrôlements collectés HORS-LIGNE par un agent mobile puis synchronisé.
///
/// IDEMPOTENCE : `batchId` (clé naturelle fournie par le kit) est UNIQUE — un
/// renvoi du même lot (perte réseau, retry) ne crée pas de doublon. La charge
/// est SIGNÉE et HORODATÉE côté kit ; `payloadHash` (SHA-256 du payload canon)
/// et `signature` permettent de prouver l'intégrité avant import. Aucun NINA en
/// clair n'est stocké au niveau du lot.
model OfflineEnrollmentBatch {
  id                String             @id @default(uuid()) @db.Uuid
  /// Clé naturelle d'idempotence fournie par le kit (UNIQUE).
  batchId           String             @unique @map("batch_id") @db.VarChar(100)
  /// Agent mobile auteur de la collecte (MobileAgent.id).
  mobileAgentId     String             @map("mobile_agent_id") @db.Uuid
  /// Compte User collecteur (redondant pour audit rapide).
  collectedByUserId String             @map("collected_by_user_id") @db.Uuid
  status            OfflineBatchStatus @default(RECEIVED)
  /// Nombre de fiches déclarées dans le lot (contrôle de cohérence).
  recordCount       Int                @map("record_count")
  /// SHA-256 (hex) du payload canonicalisé du lot — intégrité.
  payloadHash       String             @map("payload_hash") @db.VarChar(64)
  /// Signature détachée du payload (base64/hex) produite par le kit.
  signature         String             @db.Text
  /// Horodatage de collecte côté kit (peut précéder la sync de ≤ 5 jours).
  collectedAt       DateTime           @map("collected_at") @db.Timestamptz(6)
  /// Horodatage de réception serveur (sync).
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  /// Agent CTDEC ayant revu le lot.
  reviewedByUserId  String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  /// Motif de rejet (signature invalide, lot expiré, doublon).
  rejectionReason   String?            @map("rejection_reason") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  mobileAgent MobileAgent @relation("BatchMobileAgent", fields: [mobileAgentId], references: [id], onDelete: Restrict)
  collectedBy User        @relation("BatchCollectedBy", fields: [collectedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("BatchReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  records OfflineEnrollmentRecord[]

  @@index([status])
  @@index([mobileAgentId])
  @@index([receivedAt])
  @@map("offline_enrollment_batches")
}

/// Fiche individuelle d'un lot offline. La déduplication par citoyen est portée
/// au niveau (lot, hash de la fiche) pour rejeter les doublons internes au lot.
model OfflineEnrollmentRecord {
  id         String              @id @default(uuid()) @db.Uuid
  batchId    String              @map("batch_id") @db.Uuid
  /// Citoyen créé/rattaché après import (nullable tant que PENDING).
  citizenId  String?             @map("citizen_id") @db.Uuid
  /// SHA-256 (hex) de la fiche canonicalisée — déduplication intra-lot.
  recordHash String              @map("record_hash") @db.VarChar(64)
  status     OfflineRecordStatus @default(PENDING)
  /// Détail d'erreur si INVALID/DUPLICATE.
  error      String?             @db.Text
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  batch   OfflineEnrollmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  citizen Citizen?               @relation(fields: [citizenId], references: [id], onDelete: Restrict)

  /// Pas deux fois la même fiche dans le même lot (idempotence intra-lot).
  @@unique([batchId, recordHash], name: "uniq_record_in_batch")
  @@index([status])
  @@map("offline_enrollment_records")
}

// ──────────────────────────────────────────────────────────────────────────────
//  C1.4 — VULNERABILITY_ACCESS_LOGS — trace DURABLE des accès aux catégories
// ──────────────────────────────────────────────────────────────────────────────

/// Journal d'accès LOCAL et DURABLE aux profils de vulnérabilité (catégorie
/// particulière RGPD-like). Garantit l'invariant « pas d'accès à une catégorie
/// sans trace » : la trace est écrite EN BASE (source de vérité) AVANT de
/// renvoyer la donnée au client, indépendamment de la disponibilité de RabbitMQ.
/// La publication vers la hash-chain SHA-256 d'audit-service reste un relais
/// asynchrone best-effort PAR-DESSUS cette trace durable (pattern outbox-like).
///
/// ⚠️ Aucun NINA en clair : le citoyen est identifié par son `citizenId` (UUID).
model VulnerabilityAccessLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Action (ex. `profile.accessed`, `profile.declared`).
  action     String   @db.VarChar(100)
  /// Type d'entité (ex. `VulnerabilityRecord`).
  entityType String   @map("entity_type") @db.VarChar(80)
  /// Identifiant d'entité ciblée (UUID citoyen ou clé de liste) — JAMAIS le NINA.
  entityId   String   @map("entity_id") @db.VarChar(120)
  /// Acteur authentifié (sub JWT / User.id) — `null` pour origine système.
  actorId    String?  @map("actor_id") @db.VarChar(100)
  /// Rôle/origine de l'acteur (`citizen`, `agent`, `supervisor`…).
  actorType  String   @map("actor_type") @db.VarChar(40)
  /// Adresse IP source.
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  /// Métadonnée métier (catégorie, compteur…) — SANS NINA en clair.
  metadata   Json?
  /// `true` une fois relayé avec succès vers RabbitMQ (audit-service).
  relayed    Boolean  @default(false)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([entityId])
  @@index([actorId])
  @@index([occurredAt])
  @@index([relayed])
  @@map("vulnerability_access_logs")
}

// ──────────────────────────────────────────────────────────────────────────────
//  C2.1 — SGOGT_SIGNED_MESSAGES — messagerie officielle signée (Bloc C2)
// ──────────────────────────────────────────────────────────────────────────────
//
//  Modèle ADDITIF (n'altère PAS `governance_messages`, conservé pour le fil de
//  discussion CRUD existant). Ici on porte la « décision administrative
//  cryptographiquement engageante » : JWS RS256 (signé via Vault Transit, clé
//  par-fonctionnaire NON exportable), claims signés couvrant TOUTE la décision
//  (sender/recipient/subject/bodyHash/threadId/priority/ttl/iat) + chaînage
//  d'intégrité SHA-256 par fil (hash-chain LINÉAIRE, PAS Merkle) + escalade.
//  Cf. docs/governance/SGOGT-PROTOCOL.md (contrat normatif).

/// Classification d'urgence d'un message SGOGT — pilote le délai d'escalade.
enum SgogtPriority {
  NORMAL
  HIGH
  CRITICAL

  @@map("sgogt_priority")
}

/// Cycle de vie d'un message SGOGT signé.
enum SgogtStatus {
  SENT
  READ
  RESPONDED
  ESCALATED
  ARCHIVED

  @@map("sgogt_status")
}

/// Message officiel SIGNÉ (JWS RS256 via Vault Transit) — non-répudiation.
///
/// Le `jwsSignature` couvre les `signedClaims` (sender/recipient/subject/
/// bodyHash/threadId/priority/ttlEscalateAt/iat). On ne signe PAS le `body` brut
/// mais son `bodyHash` (SHA-256) — JWS compact même pour un message long.
/// `chainHash` = SHA-256(previousChainHash | bodyHash | jwsSignature | createdAt)
/// chaîne les messages D'UN MÊME FIL (anti-altération / anti-suppression locale).
/// L'intégrité long terme reste portée par la hash-chain SHA-256 d'audit-service.
model SgogtSignedMessage {
  id                String        @id @default(uuid()) @db.Uuid
  /// Groupe de messages liés (fil de décision). Couvert par la signature.
  threadId          String        @map("thread_id") @db.Uuid
  /// Émetteur (FK User) — lié à `req.user.id` authentifié, jamais au client.
  senderId          String        @map("sender_id") @db.Uuid
  /// Destinataire direct (FK User).
  recipientId       String        @map("recipient_id") @db.Uuid
  subject           String        @db.VarChar(300)
  body              String        @db.Text
  /// SHA-256 (hex) du `body` — signé à la place du corps brut.
  bodyHash          String        @map("body_hash") @db.VarChar(64)
  /// JWS compact RS256 (signature déléguée Vault Transit). Format RFC 7515.
  jwsSignature      String        @map("jws_signature") @db.Text
  /// Claims couverts par la signature (anti-rejeu / anti-altération).
  signedClaims      Json          @map("signed_claims")
  /// `kid` Vault de la clé signataire (`sgogt-user-<senderId>`).
  signingKid        String        @map("signing_kid") @db.VarChar(120)
  priority          SgogtPriority @default(NORMAL)
  status            SgogtStatus   @default(SENT)
  /// Échéance d'escalade (dérivée AVANT signature → immuable). CRITICAL=4h, sinon 24h.
  ttlEscalateAt     DateTime      @map("ttl_escalate_at") @db.Timestamptz(6)
  /// Supérieur ayant pris le relais après escalade (FK User).
  escalatedToId     String?       @map("escalated_to_id") @db.Uuid
  escalatedAt       DateTime?     @map("escalated_at") @db.Timestamptz(6)
  readAt            DateTime?     @map("read_at") @db.Timestamptz(6)
  respondedAt       DateTime?     @map("responded_at") @db.Timestamptz(6)
  /// ACK signé du destinataire (JWS RS256 du lecteur) — preuve de réception.
  readReceiptJws    String?       @map("read_receipt_jws") @db.Text
  /// Hash du message précédent du MÊME fil (ou GENESIS = 64 zéros).
  previousChainHash String        @map("previous_chain_hash") @db.VarChar(64)
  /// Hash chaîné de CE message (intégrité locale du fil).
  chainHash         String        @unique @map("chain_hash") @db.VarChar(64)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  sender      User                   @relation("SgogtSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient   User                   @relation("SgogtRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  escalations SgogtEscalationEvent[]

  @@index([recipientId, status])
  @@index([threadId])
  @@index([status, ttlEscalateAt])
  @@map("sgogt_signed_messages")
}

/// Historique d'escalade SIGNÉ (non falsifiable) d'un message SGOGT.
///
/// Chaque escalade automatique (TTL dépassé sans accusé) émet une ligne SIGNÉE
/// par la clé `elections-export`/`sgogt-system` (clé système Vault) et chaînée
/// (SHA-256) à l'événement précédent du même message → piste d'audit immuable.
model SgogtEscalationEvent {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  /// Destinataire AVANT escalade (FK User).
  fromUserId   String   @map("from_user_id") @db.Uuid
  /// Destinataire APRÈS escalade — supérieur hiérarchique (FK User).
  toUserId     String   @map("to_user_id") @db.Uuid
  /// Niveau d'escalade atteint (1 = premier cran).
  level        Int      @default(1)
  /// Raison (`TTL_EXPIRED`).
  reason       String   @default("TTL_EXPIRED") @db.VarChar(40)
  /// JWS RS256 (clé système Vault) couvrant {messageId,from,to,level,at}.
  signatureJws String   @map("signature_jws") @db.Text
  /// Hash de l'événement d'escalade précédent (ou GENESIS).
  previousHash String   @map("previous_hash") @db.VarChar(64)
  /// Hash chaîné de CET événement.
  chainHash    String   @unique @map("chain_hash") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message SgogtSignedMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([toUserId])
  @@map("sgogt_escalation_events")
}

// ──────────────────────────────────────────────────────────────────────────────
//  C2.2 — GOVERNANCE_TASKS — directives Kanban (Bloc C2)
// ──────────────────────────────────────────────────────────────────────────────
//
//  Modèle ADDITIF (n'altère PAS `governance_directives`). Tableau Kanban des
//  directives avec cycle de vie strict + assignee + deadline + historique de
//  transitions audité.

/// Colonne Kanban / cycle de vie d'une directive (tâche de gouvernance).
enum GovernanceTaskStatus {
  DRAFT
  SENT
  IN_PROGRESS
  COMPLETED
  REJECTED

  @@map("governance_task_status")
}

/// Directive opérationnelle suivie en Kanban (DRAFT→SENT→IN_PROGRESS→…).
model GovernanceTask {
  id              String               @id @default(uuid()) @db.Uuid
  title           String               @db.VarChar(300)
  description     String               @db.Text
  status          GovernanceTaskStatus @default(DRAFT)
  /// Créateur/émetteur (FK User).
  createdById     String               @map("created_by_id") @db.Uuid
  /// Responsable de l'exécution (FK User).
  assigneeId      String?              @map("assignee_id") @db.Uuid
  priority        SgogtPriority        @default(NORMAL)
  deadline        DateTime?            @db.Timestamptz(6)
  /// Niveau d'escalade (0 = initial).
  escalationLevel Int                  @default(0) @map("escalation_level")
  rejectionReason String?              @map("rejection_reason") @db.Text
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy   User                  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee    User?                 @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  transitions GovernanceTaskEvent[]

  @@index([status])
  @@index([assigneeId])
  @@index([createdById])
  @@map("governance_tasks")
}

/// Transition de cycle de vie d'une `GovernanceTask` (audit local des changements).
model GovernanceTaskEvent {
  id         String                @id @default(uuid()) @db.Uuid
  taskId     String                @map("task_id") @db.Uuid
  fromStatus GovernanceTaskStatus? @map("from_status")
  toStatus   GovernanceTaskStatus  @map("to_status")
  /// Acteur de la transition (sub JWT) — chaîne libre (pas FK : peut être système).
  actorId    String                @map("actor_id") @db.VarChar(100)
  note       String?               @db.Text
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  task GovernanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("governance_task_events")
}

// ──────────────────────────────────────────────────────────────────────────────
//  C3.1 — ELECTORAL_PSEUDONYMS — registre électoral pseudonymisé (Bloc C3)
// ──────────────────────────────────────────────────────────────────────────────
//
//  Modèle ADDITIF (n'altère PAS `electoral_records`). Porte le `pseudonymousId`
//  HMAC-SHA256 calculé DANS Vault (clé non exportable, PAS un SHA-256(NINA+sel)
//  bruteforçable) + `saltVersion` PUBLIC (séparation de domaine, rotation).
//  Source de l'export delta DGE. Cf. docs/governance/ELECTIONS-EXPORT-CONTRACT.md.

/// Type d'inscription au registre électoral.
enum VoterInscriptionType {
  AUTO_18
  MANUAL
  TRANSFER

  @@map("voter_inscription_type")
}

/// Statut électoral (actif / radié avec motif).
enum VoterStatus {
  ACTIVE
  REMOVED_DECEASED
  REMOVED_RELOCATED
  REMOVED_DISQUALIFIED

  @@map("voter_status")
}

/// Ligne pseudonymisée du registre électoral (delta exporté vers la DGE).
model ElectoralPseudonym {
  id              String               @id @default(uuid()) @db.Uuid
  /// Citoyen source (UUID) — JAMAIS exporté vers la DGE. Lien interne seulement.
  citizenId       String               @unique @map("citizen_id") @db.Uuid
  /// HMAC-SHA256(`v<salt>:<nina>`) calculé DANS Vault (clé non exportable).
  /// STABLE entre exports (linkable par conception, cf. avertissement contrat §10).
  pseudonymousId  String               @unique @map("pseudonymous_id") @db.VarChar(128)
  /// Tag de séparation de domaine PUBLIC (PAS un secret) — version de contexte HMAC.
  saltVersion     Int                  @map("salt_version")
  region          String               @db.VarChar(100)
  cercle          String               @db.VarChar(100)
  commune         String?              @db.VarChar(100)
  inscriptionType VoterInscriptionType @default(AUTO_18) @map("inscription_type")
  status          VoterStatus          @default(ACTIVE)
  registeredAt    DateTime             @default(now()) @map("registered_at") @db.Timestamptz(6)
  removedAt       DateTime?            @map("removed_at") @db.Timestamptz(6)
  removedReason   String?              @map("removed_reason") @db.VarChar(120)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Restrict)

  @@index([region, status])
  @@index([pseudonymousId])
  @@index([registeredAt])
  @@index([removedAt])
  @@map("electoral_pseudonyms")
}

// ──────────────────────────────────────────────────────────────────────────────
//  C3.2 — DGE_EXPORT_QUOTA — quota atomique PAR COMPTE (anti-exfiltration)
// ──────────────────────────────────────────────────────────────────────────────

/// Compteur quotidien d'exports DGE PAR COMPTE. Incrément ATOMIQUE (UPDATE
/// conditionnel `count < limit`) AVANT le stream — pas de comptage TOCTOU dérivé
/// d'`audit_logs`. Un compte DGE compromis est borné à `limit` exports/jour.
model DgeExportQuota {
  /// Compte DGE (sub JWT du DGE_OFFICIAL).
  accountId String   @map("account_id") @db.VarChar(100)
  /// Jour (UTC, format `YYYY-MM-DD`).
  day       String   @db.VarChar(10)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([accountId, day])
  @@map("dge_export_quota")
}

// ──────────────────────────────────────────────────────────────────────────────
//  C3.3 — ELECTORAL_EXPORT_LOGS — journal local des exports DGE
// ──────────────────────────────────────────────────────────────────────────────

/// Trace LOCALE et DURABLE de chaque export DGE (en complément de la hash-chain
/// SHA-256 d'audit-service). Rend un compte DGE compromis détectable : qui /
/// quand / fenêtre `since` / nb lignes / sha256 / IP.
model ElectoralExportLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Compte DGE exportateur (sub JWT vérifié).
  accountId   String   @map("account_id") @db.VarChar(100)
  /// Fenêtre temporelle demandée (ISO-8601).
  sinceIso    String   @map("since_iso") @db.VarChar(40)
  /// Nombre de lignes du delta.
  rowCount    Int      @map("row_count")
  /// SHA-256 (hex) du corps CSV exporté.
  sha256      String   @db.VarChar(64)
  saltVersion Int      @map("salt_version")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId])
  @@index([createdAt])
  @@map("electoral_export_logs")
}
