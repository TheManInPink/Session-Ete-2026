// ══════════════════════════════════════════════════════════════════════════════
//  NINA-AES Platform — Schéma Prisma 7 (PostgreSQL 18)
//  16 tables métier couvrant les blocs A (NINA Mali) → F (Biométrie, plan).
//  Aligné PROMPT 1.3 (avril 2026).
//
//  Conventions :
//    - Tous les modèles sont mappés en `snake_case` via @@map.
//    - Toutes les colonnes utilisent @map quand le nom Prisma diffère.
//    - Relations en onDelete: Restrict (intégrité référentielle stricte).
//    - Soft-delete via `deletedAt` sur les entités sensibles (Citizen, User,
//      CorrectionRequest) — interception au niveau du client (cf. src/index.ts).
//    - Index trigram (gin_trgm_ops) sur les colonnes de recherche fuzzy.
//
//  @author  Étudiant UQAR
//  @date    Avril 2026
//  @see     docs/06-DATABASE-SCHEMA-PRISMA.md
// ══════════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  // Prisma 7.x utilise le moteur « client » (queries compilées) qui exige
  // un driver adapter natif. Pour PostgreSQL on utilise `@prisma/adapter-pg`
  // (cf. `src/index.ts`) — `driverAdapters` est stable depuis Prisma 7 et
  // n'a plus besoin d'être listé en previewFeatures.
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  // L'URL de connexion est fournie par prisma.config.ts (CLI) et par
  // l'environnement (`DATABASE_URL`) au runtime — Prisma 7 n'autorise plus
  // `url` ici.
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto, pg_trgm, unaccent, citext, postgis]
}

// ──────────────────────────────────────────────────────────────────────────────
//  ENUMS — alignés sur packages/shared-types/src/enums.ts
// ──────────────────────────────────────────────────────────────────────────────

/// Sexe déclaré (aligné NINA + état civil).
enum Sex {
  MALE
  FEMALE
  UNKNOWN

  @@map("sex")
}

/// Statut matrimonial FDI.
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  CIVIL_UNION

  @@map("marital_status")
}

/// Rôles applicatifs (RBAC) — 6 rôles distincts.
enum UserRole {
  CITIZEN
  AGENT
  SUPERVISOR
  ADMIN
  AUDITOR
  ANTICORRUPTION_INSPECTOR

  @@map("user_role")
}

/// Cycle de vie d'une demande de correction NINA.
enum CorrectionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED

  @@map("correction_status")
}

/// Cycle de vie d'un rendez-vous CTDEC / antenne RAVEC.
enum AppointmentStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

/// Cycle de vie d'une directive de gouvernance (SGOGT).
enum DirectiveStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  ESCALATED
  CLOSED
  ARCHIVED

  @@map("directive_status")
}

/// Gravité d'une alerte (SIGAC, intégrité, sécurité).
enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("alert_severity")
}

/// Catégories de vulnérabilité (priorisation agents mobiles / USSD).
enum VulnerabilityCategory {
  ELDERLY
  DISABLED
  PREGNANT
  CHRONIC_ILL
  ILLITERATE
  DIASPORA

  @@map("vulnerability_category")
}

/// Niveau de priorité opérationnelle (file d'attente).
enum PriorityLevel {
  P1
  P2
  P3

  @@map("priority_level")
}

/// Langues nationales supportées (UI + USSD + notifications).
enum Language {
  FR
  BM
  SNK
  FF
  TMQ
  HAU
  MOS
  DJE

  @@map("language")
}

// ──────────────────────────────────────────────────────────────────────────────
//  1. LOCATIONS — hiérarchie administrative (pays → … → fraction)
// ──────────────────────────────────────────────────────────────────────────────

/// Entité administrative hiérarchique (8 niveaux : pays → région → cercle →
/// commune → arrondissement → quartier → village → fraction).
/// Auto-référente : `parent` relie un niveau à son parent immédiat.
model Location {
  id        String                                @id @default(uuid()) @db.Uuid
  /// Code administratif officiel (ex. "ML-08-02-005"). Unique.
  code      String                                @unique @db.VarChar(20)
  name      String                                @db.VarChar(150)
  /// Version ASCII (sans diacritiques) pour recherche fuzzy + index trigram.
  nameAscii String                                @map("name_ascii") @db.VarChar(150)
  /// Niveau dans la hiérarchie : 0=pays, 1=région, 2=cercle, 3=commune,
  /// 4=arrondissement, 5=quartier, 6=village, 7=fraction.
  level     Int                                   @db.SmallInt
  parentId  String?                               @map("parent_id") @db.Uuid
  latitude  Decimal?                              @db.Decimal(10, 7)
  longitude Decimal?                              @db.Decimal(10, 7)
  /// Point géographique PostGIS (EPSG:4326). Rempli par trigger SQL.
  geom      Unsupported("geography(Point,4326)")?
  createdAt DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children Location[] @relation("LocationHierarchy")

  citizensBirth     Citizen[]         @relation("BirthLocation")
  citizensResidence Citizen[]         @relation("ResidenceLocation")
  appointments      Appointment[]
  electoralRecords  ElectoralRecord[]
  institutions      Institution[]

  @@index([parentId])
  @@index([level])
  @@index([nameAscii(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_locations_name_ascii_trgm")
  @@map("locations")
}

// ──────────────────────────────────────────────────────────────────────────────
//  2. CITIZENS — enregistrement NINA canonique
// ──────────────────────────────────────────────────────────────────────────────

/// Enregistrement NINA — table principale du système d'identité.
model Citizen {
  id                    String                 @id @default(uuid()) @db.Uuid
  /// Numéro NINA : 14 chiffres + 1 lettre de contrôle.
  nina                  String                 @unique @db.VarChar(15)
  firstName             String                 @map("first_name") @db.VarChar(100)
  lastName              String                 @map("last_name") @db.VarChar(100)
  /// Versions ASCII indexées trigram pour recherche fuzzy.
  firstNameAscii        String                 @map("first_name_ascii") @db.VarChar(100)
  lastNameAscii         String                 @map("last_name_ascii") @db.VarChar(100)
  birthDate             DateTime               @map("birth_date") @db.Date
  sex                   Sex
  maritalStatus         MaritalStatus          @default(SINGLE) @map("marital_status")
  profession            String?                @db.VarChar(100)
  photoUrl              String?                @map("photo_url") @db.VarChar(500)
  /// Hash SHA-256 de la photo (vérifiable depuis le QR JWT).
  photoHash             String?                @map("photo_hash") @db.VarChar(64)
  /// Hash SHA-256 du template biométrique (Bloc F — jamais le template brut).
  fingerprintHash       String?                @map("fingerprint_hash") @db.VarChar(64)
  /// Catégorie principale de vulnérabilité (file prioritaire). Le détail
  /// (preuves, dates de validité, …) reste dans `VulnerabilityRecord`.
  vulnerabilityCategory VulnerabilityCategory? @map("vulnerability_category")
  birthPlaceId          String                 @map("birth_place_id") @db.Uuid
  residenceId           String                 @map("residence_id") @db.Uuid
  fatherId              String?                @map("father_id") @db.Uuid
  motherId              String?                @map("mother_id") @db.Uuid
  preferredLanguage     Language               @default(FR) @map("preferred_language")
  phoneNumber           String?                @map("phone_number") @db.VarChar(20)
  email                 String?                @db.VarChar(200)
  /// Verrou optimiste pour éviter les écrasements concurrents.
  version               Int                    @default(0)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)

  birthPlace Location @relation("BirthLocation", fields: [birthPlaceId], references: [id], onDelete: Restrict)
  residence  Location @relation("ResidenceLocation", fields: [residenceId], references: [id], onDelete: Restrict)
  father     Parent?  @relation("FatherOf", fields: [fatherId], references: [id], onDelete: Restrict)
  mother     Parent?  @relation("MotherOf", fields: [motherId], references: [id], onDelete: Restrict)

  correctionRequests CorrectionRequest[]
  appointments       Appointment[]
  vulnerabilities    VulnerabilityRecord[]
  electoralRecord    ElectoralRecord?
  notifications      Notification[]

  @@index([lastName])
  @@index([birthDate])
  @@index([sex])
  @@index([deletedAt])
  @@index([vulnerabilityCategory])
  @@index([lastNameAscii(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_citizens_lastname_trgm")
  @@index([firstNameAscii(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_citizens_firstname_trgm")
  @@map("citizens")
}

// ──────────────────────────────────────────────────────────────────────────────
//  3. PARENTS — père / mère sur la FDI
// ──────────────────────────────────────────────────────────────────────────────

/// Parent (père ou mère) d'un·e citoyen·ne. Peut être partagé si fratrie.
model Parent {
  id        String    @id @default(uuid()) @db.Uuid
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String    @map("last_name") @db.VarChar(100)
  /// NINA du parent s'il·elle est lui-même enregistré·e. Nullable.
  nina      String?   @unique @db.VarChar(15)
  sex       Sex
  birthDate DateTime? @map("birth_date") @db.Date
  deceased  Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  fatheredChildren Citizen[] @relation("FatherOf")
  motheredChildren Citizen[] @relation("MotherOf")

  @@index([lastName])
  @@map("parents")
}

// ──────────────────────────────────────────────────────────────────────────────
//  4. CORRECTION_REQUESTS — workflow citoyen ↔ agent
// ──────────────────────────────────────────────────────────────────────────────

/// Demande de correction d'un champ NINA (workflow citoyen ↔ agent).
model CorrectionRequest {
  id                  String           @id @default(uuid()) @db.Uuid
  citizenId           String           @map("citizen_id") @db.Uuid
  requestedByUserId   String?          @map("requested_by_user_id") @db.Uuid
  /// Agent assigné (alias UI : `reviewedBy`).
  reviewedBy          String?          @map("reviewed_by") @db.Uuid
  field               String           @db.VarChar(50)
  currentValue        String           @map("current_value") @db.VarChar(500)
  proposedValue       String           @map("proposed_value") @db.VarChar(500)
  reason              String           @db.Text
  /// URL MinIO du justificatif scanné (CIN, acte de naissance…).
  justificationDocUrl String?          @map("justification_doc_url") @db.VarChar(500)
  /// Score IA (0-100) — cf. doc 11 (ai-service).
  aiScore             Decimal?         @map("ai_score") @db.Decimal(5, 2)
  aiVerdict           String?          @map("ai_verdict") @db.VarChar(30)
  aiExplanation       Json?            @map("ai_explanation")
  status              CorrectionStatus @default(DRAFT)
  decidedAt           DateTime?        @map("decided_at") @db.Timestamptz(6)
  decisionReason      String?          @map("decision_reason") @db.Text
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6)

  citizen     Citizen @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  requestedBy User?   @relation("CorrectionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewer    User?   @relation("CorrectionReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([citizenId])
  @@index([status])
  @@index([reviewedBy])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("correction_requests")
}

// ──────────────────────────────────────────────────────────────────────────────
//  5. USERS — agents internes (les citoyens passent par Keycloak directement)
// ──────────────────────────────────────────────────────────────────────────────

/// Utilisateur interne (agents, superviseurs, admins, auditeurs, inspecteurs).
model User {
  id                String    @id @default(uuid()) @db.Uuid
  /// Identifiant Keycloak (sub). Source de vérité de l'auth.
  keycloakId        String    @unique @map("keycloak_id") @db.VarChar(100)
  email             String    @unique @db.VarChar(200)
  username          String    @unique @db.VarChar(100)
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  role              UserRole
  institutionId     String?   @map("institution_id") @db.Uuid
  phoneNumber       String?   @map("phone_number") @db.VarChar(20)
  preferredLanguage Language  @default(FR) @map("preferred_language")
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  /// Secret TOTP (HMAC-SHA1) chiffré au repos via Vault Transit (cf. doc 15).
  /// Format stocké : `vault:v1:<ciphertext>`. Jamais en clair en DB.
  mfaSecret         String?   @map("mfa_secret") @db.VarChar(255)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  institution             Institution?          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  requestedCorrections    CorrectionRequest[]   @relation("CorrectionRequestedBy")
  reviewedCorrections     CorrectionRequest[]   @relation("CorrectionReviewedBy")
  assignedAppointments    Appointment[]
  auditLogs               AuditLog[]
  issuedDirectives        GovernanceDirective[] @relation("DirectiveIssuer")
  assignedDirectives      GovernanceDirective[] @relation("DirectiveAssignee")
  sentMessages            GovernanceMessage[]   @relation("MessageSender")
  receivedMessages        GovernanceMessage[]   @relation("MessageRecipient")
  verifiedVulnerabilities VulnerabilityRecord[]
  reportedAlerts          CorruptionAlert[]     @relation("AlertReporter")
  agentAlerts             CorruptionAlert[]     @relation("AlertAgent")
  assignedAlerts          CorruptionAlert[]     @relation("AlertAssignedTo")
  notifications           Notification[]
  directiveRecipients     DirectiveRecipient[]

  @@index([role])
  @@index([institutionId])
  @@index([deletedAt])
  @@map("users")
}

// ──────────────────────────────────────────────────────────────────────────────
//  6. AUDIT_LOGS — journal append-only chaîné Merkle
// ──────────────────────────────────────────────────────────────────────────────

/// Journal d'audit append-only + chaîne Merkle (cf. doc 09).
///
/// Chaque modification d'une ressource sensible est journalisée avec la
/// valeur précédente (`oldValue`) et la nouvelle (`newValue`) sérialisées
/// en JSON, signée par le service émetteur, et chaînée au hash précédent.
model AuditLog {
  /// BigInt pour supporter 10 ans de rétention à ~10k events/jour.
  id            BigInt   @id @default(autoincrement())
  /// Utilisateur acteur (UUID Keycloak via User). Null = non authentifié / système.
  userId        String?  @map("user_id") @db.Uuid
  actorType     String   @map("actor_type") @db.VarChar(30)
  action        String   @db.VarChar(100)
  /// Type d'entité affectée (ex. `Citizen`, `CorrectionRequest`).
  entityType    String   @map("entity_type") @db.VarChar(80)
  /// Identifiant de l'entité (UUID ou clé naturelle).
  entityId      String?  @map("entity_id") @db.VarChar(100)
  /// Ancienne valeur (PII rédigée) sérialisée JSON.
  oldValue      Json?    @map("old_value")
  /// Nouvelle valeur (PII rédigée) sérialisée JSON.
  newValue      Json?    @map("new_value")
  /// Adresse IP source.
  ipAddress     String?  @map("ip_address") @db.Inet
  /// Hash SHA-256 du payload JSON canonicalisé (JCS RFC 8785).
  payloadHash   String   @map("payload_hash") @db.VarChar(64)
  /// Hash chaîné de l'événement précédent (ou GENESIS = 64 zéros).
  previousHash  String   @map("previous_hash") @db.VarChar(64)
  /// Hash de chaîne Merkle de l'événement courant — unique, scellé.
  merkleHash    String   @unique @map("merkle_hash") @db.VarChar(64)
  /// Signature Ed25519 du root Merkle de l'heure (posée par cron).
  signature     String?  @db.VarChar(128)
  /// Identifiant d'événement source (idempotence AMQP).
  sourceEventId String   @unique @map("source_event_id") @db.VarChar(100)
  correlationId String?  @map("correlation_id") @db.VarChar(100)
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([action])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────────────────────────────────────
//  6bis. AUDIT_ROOTS — racines scellées Ed25519 (ancrage temporel)
// ──────────────────────────────────────────────────────────────────────────────

/// Racine périodique scellée de la chaîne d'audit (cf. doc 09 §12).
///
/// Toutes les heures, `audit-service` lit le dernier `AuditLog.merkleHash`
/// (la « racine » courante de la chaîne) et signe `chainRootHash|signedAt`
/// avec une clé Ed25519 (privée gardée dans Vault). Même si un attaquant
/// parvenait à réécrire toute la chaîne en base, il ne pourrait pas reforger
/// une signature Ed25519 valide → la falsification reste prouvable.
///
/// Table également append-only (mêmes triggers que `audit_logs`).
model AuditRoot {
  /// BigInt aligné sur la volumétrie de `AuditLog`.
  id                BigInt   @id @default(autoincrement())
  /// `merkleHash` du dernier `AuditLog` couvert par cette racine.
  chainRootHash     String   @map("chain_root_hash") @db.VarChar(64)
  /// id du dernier `AuditLog` couvert (borne haute de l'intervalle scellé).
  lastLogId         BigInt   @map("last_log_id")
  /// Nombre total de logs couverts au moment du scellement (cumulatif).
  logCountCovered   Int      @map("log_count_covered")
  /// Signature Ed25519 (hex, 128 chars) de `chainRootHash|signedAt(ISO)`.
  signature         String   @db.VarChar(160)
  /// Identifiant de la clé de signature (support rotation Vault).
  signingKeyId      String   @map("signing_key_id") @db.VarChar(80)
  /// Vrai si la racine a été publiée sur un canal externe (notarisation hebdo).
  publishedExternal Boolean  @default(false) @map("published_external")
  signedAt          DateTime @default(now()) @map("signed_at") @db.Timestamptz(6)

  @@index([signedAt])
  @@index([lastLogId])
  @@map("audit_roots")
}

// ──────────────────────────────────────────────────────────────────────────────
//  7. APPOINTMENTS — RDV en CTDEC, mairie ou antenne mobile RAVEC
// ──────────────────────────────────────────────────────────────────────────────

/// Rendez-vous au CTDEC, en mairie ou en antenne mobile RAVEC.
model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  citizenId   String            @map("citizen_id") @db.Uuid
  /// Centre / antenne hôte (relation Institution). Stocké sous `institution_id`
  /// en BD pour rétro-compatibilité, mais nommé `centerId` côté Prisma /
  /// applicatif (vocabulaire métier RAVEC).
  centerId    String            @map("institution_id") @db.Uuid
  locationId  String?           @map("location_id") @db.Uuid
  agentId     String?           @map("agent_id") @db.Uuid
  status      AppointmentStatus @default(REQUESTED)
  /// Numéro dans la file d'attente du jour (1, 2, …).
  queueNumber Int?              @map("queue_number")
  priority    PriorityLevel     @default(P3)
  purpose     String            @db.VarChar(100)
  scheduledAt DateTime          @map("scheduled_at") @db.Timestamptz(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(6)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  citizen  Citizen     @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  center   Institution @relation(fields: [centerId], references: [id], onDelete: Restrict)
  location Location?   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  agent    User?       @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([citizenId])
  @@index([status])
  @@index([scheduledAt])
  @@index([centerId])
  @@map("appointments")
}

// ──────────────────────────────────────────────────────────────────────────────
//  8. AES_VERIFICATION_LOGS — interopérabilité transfrontalière
// ──────────────────────────────────────────────────────────────────────────────

/// Journal des vérifications transfrontalières BCID-AES (Niger, Burkina Faso).
model AesVerificationLog {
  id                String   @id @default(uuid()) @db.Uuid
  /// Pays requêteur (ISO 3166-1 alpha-3 : MLI, BFA, NER).
  requesterCountry  String   @map("requester_country") @db.Char(3)
  /// NINA cible — chiffré au repos par le service interop (cf. doc 21).
  targetNina        String   @map("target_nina") @db.VarChar(15)
  /// Hash SHA-256 du NINA demandé (évite la fuite si la table est compromise).
  requestedNinaHash String   @map("requested_nina_hash") @db.VarChar(64)
  /// Type : IDENTITY_CHECK, STATUS_CHECK, SIGNATURE_VERIFY.
  requestType       String   @map("request_type") @db.VarChar(40)
  /// Verdict : MATCH, NO_MATCH, EXPIRED, REVOKED, ERROR.
  result            String   @db.VarChar(20)
  /// Indice de confiance (0–100) — fuzzy matching pour translittérations.
  confidence        Decimal? @db.Decimal(5, 2)
  latencyMs         Int      @map("latency_ms")
  /// Signature Ed25519 de la réponse (pour non-répudiation).
  signature         String   @db.VarChar(128)
  correlationId     String   @map("correlation_id") @db.VarChar(100)
  clientIp          String?  @map("client_ip") @db.Inet
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([requesterCountry])
  @@index([createdAt])
  @@index([result])
  @@map("aes_verification_logs")
}

// ──────────────────────────────────────────────────────────────────────────────
//  9. CORRUPTION_ALERTS — SIGAC (Bloc D)
// ──────────────────────────────────────────────────────────────────────────────

/// Alerte anti-corruption (signalement + détection automatique IA).
model CorruptionAlert {
  id                     String        @id @default(uuid()) @db.Uuid
  /// Rapporteur (agent ou citoyen identifié). Null = lanceur d'alerte anonyme.
  reporterId             String?       @map("reporter_id") @db.Uuid
  /// Agent visé par le signalement (cible). Null = non nominatif.
  agentUserId            String?       @map("agent_user_id") @db.Uuid
  assignedToUserId       String?       @map("assigned_to_user_id") @db.Uuid
  severity               AlertSeverity @default(LOW)
  /// Catégorie : BRIBERY, FORGERY, FAVORITISM, ABUSE, PROCUREMENT, OTHER.
  category               String        @db.VarChar(30)
  title                  String        @db.VarChar(300)
  description            String        @map("body") @db.Text
  /// URLs MinIO des pièces jointes (chiffrées SSE-C).
  evidenceUrls           String[]      @map("evidence_urls")
  /// Jeton anonyme remis au lanceur d'alerte pour suivre l'instruction sans
  /// révéler son identité (rotation Vault).
  anonymousReporterToken String?       @unique @map("anonymous_reporter_token") @db.VarChar(128)
  /// Score d'intégrité IA (0-100), 5 facteurs pondérés (cf. doc 23).
  integrityScore         Decimal       @default(0) @map("integrity_score") @db.Decimal(5, 2)
  /// Montant impliqué en XOF si détournement financier.
  estimatedAmount        Decimal?      @map("estimated_amount") @db.Decimal(18, 2)
  /// Payload chiffré asymétriquement (clé publique inspecteur, cf. doc 23).
  encryptedPayload       Bytes?        @map("encrypted_payload")
  encryptionKeyId        String?       @map("encryption_key_id") @db.VarChar(64)
  /// Statut : RECEIVED, TRIAGED, INVESTIGATING, SUBSTANTIATED, DISMISSED, CLOSED.
  status                 String        @default("RECEIVED") @db.VarChar(30)
  channel                String        @db.VarChar(20)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter   User? @relation("AlertReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  agent      User? @relation("AlertAgent", fields: [agentUserId], references: [id], onDelete: Restrict)
  assignedTo User? @relation("AlertAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Restrict)

  @@index([severity])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([agentUserId])
  @@map("corruption_alerts")
}

// ──────────────────────────────────────────────────────────────────────────────
//  10. GOVERNANCE_DIRECTIVES — SGOGT (Bloc C2)
// ──────────────────────────────────────────────────────────────────────────────

/// Directive officielle signée (Ed25519) remplaçant les appels téléphoniques.
model GovernanceDirective {
  id              String          @id @default(uuid()) @db.Uuid
  reference       String          @unique @db.VarChar(50)
  title           String          @db.VarChar(300)
  description     String          @map("body") @db.Text
  /// Portée : national, regional, local.
  scope           String          @db.VarChar(20)
  regionCode      String?         @map("region_code") @db.VarChar(10)
  /// Émetteur de la directive (FK User).
  issuerId        String          @map("issued_by_user_id") @db.Uuid
  /// Destinataire principal de l'exécution (FK User). Les destinataires
  /// secondaires passent par `DirectiveRecipient` (N:N).
  assigneeId      String?         @map("assignee_id") @db.Uuid
  /// Institution émettrice (FK Institution).
  institutionId   String?         @map("institution_id") @db.Uuid
  status          DirectiveStatus @default(DRAFT)
  priority        PriorityLevel   @default(P3)
  /// 0 = niveau local, 1+ = escalade hiérarchique successive.
  escalationLevel Int             @default(0) @map("escalation_level")
  deadline        DateTime?       @map("deadline") @db.Timestamptz(6)
  /// Signature Ed25519 base64.
  signature       String?         @db.VarChar(128)
  signedAt        DateTime?       @map("signed_at") @db.Timestamptz(6)
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(6)
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  issuer      User                 @relation("DirectiveIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  assignee    User?                @relation("DirectiveAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  institution Institution?         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  recipients  DirectiveRecipient[]
  messages    GovernanceMessage[]

  @@index([status])
  @@index([scope])
  @@index([issuerId])
  @@index([assigneeId])
  @@index([institutionId])
  @@index([escalationLevel])
  @@index([publishedAt])
  @@map("governance_directives")
}

/// N:N — destinataires secondaires d'une directive (table de jointure).
model DirectiveRecipient {
  directiveId    String    @map("directive_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  directive GovernanceDirective @relation(fields: [directiveId], references: [id], onDelete: Restrict)
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([directiveId, userId])
  @@index([userId])
  @@map("directive_recipients")
}

// ──────────────────────────────────────────────────────────────────────────────
//  11. GOVERNANCE_MESSAGES — fil de discussion signé
// ──────────────────────────────────────────────────────────────────────────────

/// Message de gouvernance (fil de discussion attaché à une directive).
///
/// `attachments` est un tableau JSON d'objets
/// `{ filename, url, contentType, size, sha256 }` — voir `GovernanceAttachment`
/// dans `@nina-aes/shared-types`.
model GovernanceMessage {
  id             String    @id @default(uuid()) @db.Uuid
  directiveId    String?   @map("directive_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  recipientId    String?   @map("recipient_id") @db.Uuid
  /// Groupe destinataire (rôle ou région) si recipientId nul.
  recipientGroup String?   @map("recipient_group") @db.VarChar(100)
  subject        String    @db.VarChar(300)
  body           String    @db.Text
  /// Pièces jointes (JSON array) — chacune signée individuellement par SHA-256.
  attachments    Json      @default("[]")
  signature      String?   @db.VarChar(128)
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  directive GovernanceDirective? @relation(fields: [directiveId], references: [id], onDelete: Restrict)
  sender    User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient User?                @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([directiveId])
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@map("governance_messages")
}

// ──────────────────────────────────────────────────────────────────────────────
//  12. VULNERABILITY_RECORDS — Bloc C1
// ──────────────────────────────────────────────────────────────────────────────

/// Fiche de vulnérabilité rattachée à un·e citoyen·ne (priorisation files).
model VulnerabilityRecord {
  id                 String                @id @default(uuid()) @db.Uuid
  citizenId          String                @map("citizen_id") @db.Uuid
  category           VulnerabilityCategory
  description        String?               @db.Text
  /// P1 (urgent) → P3 (standard). Stocké en VARCHAR pour rétro-compat.
  priority           String                @default("P3") @db.VarChar(2)
  verifiedByUserId   String?               @map("verified_by_user_id") @db.Uuid
  verifiedAt         DateTime?             @map("verified_at") @db.Timestamptz(6)
  /// Preuve (certificat médical, attestation) — URL MinIO.
  evidenceUrl        String?               @map("evidence_url") @db.VarChar(500)
  /// Canal de notification préféré : SMS, USSD, VOICE, IN_PERSON, EMAIL.
  deliveryPreference String                @default("SMS") @map("delivery_preference") @db.VarChar(20)
  /// Numéro de téléphone pour rappels USSD (peut différer du téléphone Citizen
  /// si la fiche couvre une personne tierce — accompagnant, soignant…).
  ussdPhone          String?               @map("ussd_phone") @db.VarChar(20)
  activeFrom         DateTime              @default(now()) @map("active_from") @db.Date
  activeUntil        DateTime?             @map("active_until") @db.Date
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  citizen    Citizen @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  verifiedBy User?   @relation(fields: [verifiedByUserId], references: [id], onDelete: Restrict)

  @@index([citizenId])
  @@index([category])
  @@index([priority])
  @@index([deliveryPreference])
  @@map("vulnerability_records")
}

// ──────────────────────────────────────────────────────────────────────────────
//  13. INSTITUTIONS — CTDEC, DNEC, mairies, gouvernorats…
// ──────────────────────────────────────────────────────────────────────────────

/// Institutions publiques (CTDEC, DNEC, mairies, gouvernorats, etc.).
model Institution {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(200)
  /// Type : MINISTRY, CTDEC, DNEC, MAIRIE, GOUVERNORAT, PREFECTURE, AUTRE.
  type        String   @db.VarChar(30)
  parentId    String?  @map("parent_id") @db.Uuid
  locationId  String?  @map("location_id") @db.Uuid
  address     String?  @db.VarChar(300)
  phoneNumber String?  @map("phone_number") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent       Institution?          @relation("InstitutionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Institution[]         @relation("InstitutionTree")
  location     Location?             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  users        User[]
  appointments Appointment[]
  directives   GovernanceDirective[]

  @@index([type])
  @@index([parentId])
  @@map("institutions")
}

// ──────────────────────────────────────────────────────────────────────────────
//  14. ELECTORAL_RECORDS — Bloc C3
// ──────────────────────────────────────────────────────────────────────────────

/// Enregistrement électoral lié 1:1 à un·e citoyen·ne (auto à 18 ans).
model ElectoralRecord {
  id                 String    @id @default(uuid()) @db.Uuid
  citizenId          String    @unique @map("citizen_id") @db.Uuid
  registrationNumber String    @unique @map("registration_number") @db.VarChar(30)
  pollingStationId   String?   @map("polling_station_id") @db.Uuid
  /// Date à partir de laquelle le·la citoyen·ne est éligible (18 ans).
  eligibleAt         DateTime  @map("eligible_at") @db.Date
  /// Enregistrement actif (désactivé en cas de radiation, décès, etc.).
  active             Boolean   @default(true)
  autoRegisteredAt   DateTime? @map("auto_registered_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  citizen        Citizen   @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  pollingStation Location? @relation(fields: [pollingStationId], references: [id], onDelete: Restrict)

  @@index([active])
  @@index([pollingStationId])
  @@map("electoral_records")
}

// ──────────────────────────────────────────────────────────────────────────────
//  15. KIOSK_SESSIONS — Bloc E (bornes Electron)
// ──────────────────────────────────────────────────────────────────────────────

/// Session d'utilisation d'une borne interactive en mairie.
model KioskSession {
  id              String    @id @default(uuid()) @db.Uuid
  kioskId         String    @map("kiosk_id") @db.VarChar(50)
  /// NINA éventuellement saisi/scanné durant la session. Anonymisé si nul.
  citizenNina     String?   @map("citizen_nina") @db.VarChar(15)
  language        Language  @default(FR)
  startedAt       DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(6)
  actionsCount    Int       @default(0) @map("actions_count")
  printedReceipts Int       @default(0) @map("printed_receipts")
  ipAddress       String?   @map("ip_address") @db.Inet
  outcome         String?   @db.VarChar(30)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([kioskId])
  @@index([startedAt])
  @@map("kiosk_sessions")
}

// ──────────────────────────────────────────────────────────────────────────────
//  16. NOTIFICATIONS — notification-service (multicanal)
// ──────────────────────────────────────────────────────────────────────────────

/// Notification transactionnelle (SMS, push, email, USSD callback, voix).
model Notification {
  id                 String    @id @default(uuid()) @db.Uuid
  recipientUserId    String?   @map("recipient_user_id") @db.Uuid
  recipientCitizenId String?   @map("recipient_citizen_id") @db.Uuid
  /// Canal : SMS, PUSH, EMAIL, USSD, VOICE.
  channel            String    @db.VarChar(20)
  /// Statut : PENDING, SENT, DELIVERED, FAILED, READ.
  status             String    @default("PENDING") @db.VarChar(20)
  templateKey        String    @map("template_key") @db.VarChar(100)
  language           Language  @default(FR)
  payload            Json
  providerId         String?   @map("provider_id") @db.VarChar(100)
  sentAt             DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz(6)
  failureReason      String?   @map("failure_reason") @db.Text
  retryCount         Int       @default(0) @map("retry_count")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipientUser    User?    @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  recipientCitizen Citizen? @relation(fields: [recipientCitizenId], references: [id], onDelete: Restrict)

  @@index([recipientUserId])
  @@index([recipientCitizenId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("notifications")
}

// ──────────────────────────────────────────────────────────────────────────────
//  17. DOCUMENTS — Fiche Descriptive Individuelle (PDF + QR JWT RS256)
// ──────────────────────────────────────────────────────────────────────────────

/// Type de document généré par `document-service`.
enum DocumentType {
  FICHE_DESCRIPTIVE
  EXTRAIT_NAISSANCE
  CERTIFICAT_NATIONALITE
}

/// Motif de révocation d'un document émis.
enum DocumentRevocationReason {
  DECEASED
  FRAUD_DETECTED
  DATA_CORRECTION
  CITIZEN_REQUEST
  OTHER
}

/// Action journalisée sur un document (download, vérification QR).
enum DocumentAccessAction {
  DOWNLOAD
  VERIFY_QR
}

/// Résultat d'une action sur un document.
enum DocumentAccessResult {
  SUCCESS
  FAILURE
}

/// Document émis (FDI principalement). Append-only — toute mise à jour
/// passe par une nouvelle ligne + révocation de l'ancienne.
model Document {
  id             String       @id @default(uuid()) @db.Uuid
  /// Identifiant unique du JWT QR (UUID v7). Clé de révocation O(1).
  jti            String       @unique @db.Uuid
  /// NINA du citoyen (dénormalisé pour découpler du cycle de vie Citizen).
  nina           String       @db.VarChar(15)
  type           DocumentType @default(FICHE_DESCRIPTIVE)
  /// Numéro de souche imprimé sur le PDF (FDI-YYYY-NNNNNNN).
  serialNumber   String       @unique @map("serial_number") @db.VarChar(32)
  /// Code ISO 639-3 de la langue rendue (fra, bam, snk, fuv).
  language       String       @db.VarChar(3)
  /// SHA-256 du HTML source rendu (canonical, avant Puppeteer).
  sha256Html     String       @map("sha256_html") @db.VarChar(64)
  /// SHA-256 du PDF final (après pdf-lib post-process).
  sha256Pdf      String       @map("sha256_pdf") @db.VarChar(64)
  /// Key id Vault Transit qui a signé le QR (`nina-qr-signing-vN`).
  kid            String       @db.VarChar(64)
  minioBucket    String       @default("fiches") @map("minio_bucket") @db.VarChar(64)
  minioObjectKey String       @map("minio_object_key") @db.VarChar(256)
  minioVersionId String?      @map("minio_version_id") @db.VarChar(64)
  issuedAt       DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  /// userId Keycloak qui a déclenché l'émission (agent ou self-service).
  issuedBy       String       @map("issued_by") @db.Uuid
  issuedFromIp   String       @map("issued_from_ip") @db.VarChar(45)
  /// Watermark court (12 chars de SHA-256(ip|userAgent|jti)) imprimé en filigrane.
  watermark      String       @db.VarChar(16)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  revocation DocumentRevocation?
  accessLogs DocumentAccessLog[]

  @@index([nina, type])
  @@index([issuedAt])
  @@index([expiresAt])
  @@map("documents")
}

/// Révocation d'un document (1 ligne par jti révoqué, append-only).
model DocumentRevocation {
  id         String                   @id @default(uuid()) @db.Uuid
  documentId String                   @unique @map("document_id") @db.Uuid
  reason     DocumentRevocationReason
  reasonText String?                  @map("reason_text") @db.Text
  revokedAt  DateTime                 @default(now()) @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String                   @map("revoked_by") @db.Uuid

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@map("document_revocations")
}

/// Journal d'accès à un document (download + vérification QR).
/// Append-only — sert d'audit local en complément de l'audit Merkle global.
model DocumentAccessLog {
  id         String               @id @default(uuid()) @db.Uuid
  documentId String?              @map("document_id") @db.Uuid
  action     DocumentAccessAction
  /// Pour VERIFY_QR sans documentId (si le jti n'existe pas en base — anti-fraude).
  jti        String?              @db.Uuid
  ipAddress  String               @map("ip_address") @db.VarChar(45)
  userAgent  String?              @map("user_agent") @db.VarChar(500)
  result     DocumentAccessResult
  /// VALID | EXPIRED | REVOKED | HASH_MISMATCH | BAD_SIGNATURE | BAD_CLAIM | INVALID
  reasonCode String?              @map("reason_code") @db.VarChar(32)
  occurredAt DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(6)

  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([jti])
  @@index([occurredAt])
  @@index([action, result])
  @@map("document_access_logs")
}
