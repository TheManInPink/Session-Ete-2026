{
  "name": "@nina-aes/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma 7 schema, migrations and singleton client for the NINA-AES platform.",
  "keywords": [
    "nina",
    "aes",
    "platform",
    "database",
    "prisma",
    "postgres"
  ],
  "author": "Étudiant UQAR",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "src",
    "prisma/schema.prisma",
    "prisma/seed.ts",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist .turbo node_modules/.prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "lint": "eslint \"src/**/*.ts\" \"prisma/*.ts\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=24.11.1",
    "pnpm": ">=10.12.1"
  }
}
