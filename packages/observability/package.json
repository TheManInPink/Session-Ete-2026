{
  "name": "@nina-aes/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Module NestJS d'observabilité partagé : métriques Prometheus + tracing OTel + logs Pino-Loki",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "prom-client": "^15.1.3",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
