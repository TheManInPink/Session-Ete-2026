# ══════════════════════════════════════════════
# NINA-AES Platform — Configuration éditeur
# Compatible VS Code, WebStorm, Vim, etc.
# EditorConfig — Cohérence cross-IDE pour NINA-AES Platform
# https://editorconfig.org
# ═══════════════════════════════════════════════

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.sql]
indent_size = 4

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[*.prisma]
indent_size = 2
