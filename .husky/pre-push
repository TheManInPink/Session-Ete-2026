#!/usr/bin/env sh
# ═══════════════════════════════════════════════════════════════════
# Hook pre-push NINA-AES Platform
# ═══════════════════════════════════════════════════════════════════
# Cible : feedback < 3 min sur un PR moyen.
#
# Étapes (séquentielles, fail-fast) :
#   1. tests Jest filtrés sur les workspaces affectés depuis HEAD
#   2. build Turborepo filtré (validation que tout compile)
#
# NB : on n'exécute PAS Playwright E2E ici (trop lent, ~3 min seul).
# Les E2E tournent en CI uniquement (.github/workflows/ci.yml job
# test-e2e). Pour les rejouer en local : `pnpm run test:e2e`.
#
# Bypass exceptionnel (NON recommandé) : git push --no-verify
# ═══════════════════════════════════════════════════════════════════

# ─── 1. Tests Jest filtrés sur les workspaces affectés ───────────────
# `--filter=...[HEAD~1]` : workspaces ayant changé depuis l'avant-dernier
# commit (couvre les modifs de la branche locale qu'on s'apprête à push).
# Si rien n'a changé, turbo retourne 0 immédiatement (cache hit).
#
# Note : on NE passe PAS `--passWithNoTests` via `--` ici car chaque
# workspace l'a déjà câblé dans son script test (`jest --passWithNoTests`
# ou `vitest run --passWithNoTests`). Vitest 4 rejette le doublon
# (« Expected a single value for option "--passWithNoTests" »).
# `--concurrency=50%` : à pleine concurrence (29 tâches), la machine sature
# (specs Jest jusqu'à ×70 plus lentes, timeouts aléatoires → hook flaky ;
# constaté 2026-07-04 : interop puis biometric rouges sous charge, verts en
# isolation). La moitié des cœurs fiabilise le feedback.
echo "🧪 Tests Jest (workspaces affectés depuis HEAD~1)…"
pnpm exec turbo run test --filter=...[HEAD~1] --cache-dir=.turbo --concurrency=50% || {
  echo "❌ Au moins un test a échoué."
  echo "   → Inspectez l'output ci-dessus."
  echo "   → Pour relancer localement : pnpm test --filter=<workspace>"
  exit 1
}

# ─── 2. Build Turborepo filtré (vérifie que tout compile) ────────────
# Critique : on ne push JAMAIS du code qui ne compile pas. Le typecheck
# de pre-commit n'attrape pas tout (notamment les erreurs liées aux
# barrel exports ou aux side-effects de build).
echo "🏗️  Build Turborepo (workspaces affectés)…"
pnpm exec turbo run build --filter=...[HEAD~1] --cache-dir=.turbo || {
  echo "❌ Compilation impossible. NE PAS push tant que ce n'est pas vert."
  echo "   → Inspectez l'output ci-dessus."
  echo "   → Pour relancer : pnpm run build --filter=<workspace>"
  exit 1
}

echo "✅ pre-push OK — push autorisé"
