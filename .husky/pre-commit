#!/usr/bin/env sh
# ═══════════════════════════════════════════════════════════════════
# Hook pre-commit NINA-AES Platform
# ═══════════════════════════════════════════════════════════════════
# Cible : feedback < 30 s sur un PR moyen.
#
# Étapes (séquentielles, fail-fast) :
#   1. lint-staged   → eslint --fix + prettier --write + ruff (sur stagés)
#   2. typecheck     → turbo run check-types --filter=...[HEAD]
#   3. pnpm audit    → CVEs CRITICAL/HIGH sur deps prod
#   4. verify:repo   → invariants Mali + JSON Schemas + cross-refs docs
#
# Voir CONTRIBUTING.md §2 pour les conventions de commit.
# ═══════════════════════════════════════════════════════════════════

# ─── 1. lint-staged : formate + lint UNIQUEMENT les fichiers stagés ──
# Beaucoup plus rapide que `pnpm run lint` sur tout le repo.
echo "🧹 lint-staged…"
pnpm exec lint-staged || {
  echo "❌ Lint/format invalide sur les fichiers stagés."
  echo "   Corrigez manuellement, ou exécutez : pnpm run lint:fix && pnpm run format"
  exit 1
}

# ─── 2. Typecheck filtré sur les workspaces affectés depuis HEAD ─────
# `--filter=...[HEAD]` = workspaces qui dépendent (transitif) des
# fichiers modifiés depuis le dernier commit. Évite de recompiler tout.
echo "🔍 Typecheck (workspaces affectés)…"
pnpm exec turbo run check-types --filter=...[HEAD] --cache-dir=.turbo || {
  echo "❌ Erreurs de types TypeScript."
  echo "   Voir l'output ci-dessus pour les fichiers concernés."
  exit 1
}

# ─── 3. Audit chaîne d'approvisionnement (CVEs CRITICAL uniquement) ──
# Détecte les packages compromis ou vulnérables dans pnpm-lock.yaml.
# `--prod` ignore les devDeps (souvent bruyantes).
# Niveau CRITICAL uniquement : les HIGH bloqueraient trop souvent
# (ex. CVE next.js mineure mais notée HIGH par GitHub Advisories).
# Les HIGH sont reviewés par le CI (cf. .github/workflows/ci.yml job
# `security`) qui audite l'ensemble avec --audit-level=high.
# NB : pnpm 10/11 ne supporte pas `audit signatures` (spécifique npm).
# L'équivalent est `pnpm audit` + integrity hashes pnpm-lock.yaml.
echo "🔒 pnpm audit (prod, CRITICAL)…"
pnpm audit --audit-level=critical --prod || {
  echo "❌ Vulnérabilité CRITICAL détectée sur les dépendances prod."
  echo "   ACTION OBLIGATOIRE : pnpm update <package> + commit du lockfile."
  echo "   Bypass exceptionnel : git commit --no-verify (justification dans le body)"
  exit 1
}

# ─── 4. Chaîne verify:repo (invariants Mali + schemas + docs sync) ──
# Doit rester rapide (< 3 s en local). Si ça grossit, déplacer en pre-push.
echo "📋 verify:repo (data + schemas + docs sync)…"
pnpm run validate:data || {
  echo "❌ Invariants Mali violés. Voir scripts/validate-mali-data.mjs"
  exit 1
}
pnpm run validate:schemas || {
  echo "❌ JSON Schemas non respectés. Voir schemas/ et data/mali/"
  exit 1
}
pnpm run docs:sync:check || {
  echo "❌ Cross-références docs non synchronisées."
  echo "   → Mettre à jour les 4 fichiers gouvernance IA si une convention a changé"
  echo "   → Voir docs/DOCUMENTATION-MAP.md §2.3"
  exit 1
}

echo "✅ pre-commit OK"
